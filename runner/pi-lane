"""plan: open a whole run of lanes from one file.

The orchestrator used to spell each lane out in its own shell call with a heredoc: 85 such calls in one
measured run, 136 in another, and every one of them is context it paid for twice — once to write, once to
read back. One JSON file holds the plan, and the runner spawns one detached process per lane, so the lanes
still run in parallel.

    pi-lane plan run.json [--json]

    {
      "repo": "/home/ilja/work/bench10-lane",
      "id": "music-sdd",
      "gates": ["python3 -m unittest discover -s tests", "music sync --dry-run --root fixture"],
      "provider": "opencode-go",
      "model": "deepseek-v4.1-flash",
      "autonomy": "auto",
      "lanes": [
        {"name": "contract", "brief": "contract-brief.md", "touch": ["music/_contract.py"], "thinking": "low"},
        {"name": "pipeline", "task": "inline brief text", "touch": ["music/ingest.py"], "thinking": "medium"}
      ],
      "waves": [["contract"], ["pipeline", "library", "shell"]]
    }

`brief` is a file path (relative to the plan file), `task` is inline text. A plan with `waves` opens wave 1,
waits for it to settle, then opens the next — the dependency order, spelled out instead of remembered. A plan
without `waves` opens every lane at once.

`gates` are the commands that decide the run. They live in the plan and nowhere else, because a gate runs in
the MERGED tree: a command attached to one lane would answer for the whole repository. `pi-lane plan` writes
the plan to `$HERMES_HOME/plans/<id>/plan.json`, so `pi-lane gate --plan <id>` finds both the commands and
every lane that carries the id — after a `/tmp` cleanup has eaten the file the run was opened from.
"""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

PLAN_TERMINAL = ("done", "failed", "stopped", "cancelled", "error")


def _plan_lanes(spec: dict, base: Path) -> list:
    lanes = spec.get("lanes")
    if not isinstance(lanes, list) or not lanes:
        raise SystemExit("plan: no lanes")
    out = []
    for entry in lanes:
        if not isinstance(entry, dict):
            raise SystemExit("plan: every lane is an object")
        name = str(entry.get("name") or "").strip()
        if not name:
            raise SystemExit("plan: a lane has no name")
        task = str(entry.get("task") or "")
        brief = str(entry.get("brief") or "")
        if brief and not task:
            path = Path(brief)
            if not path.is_absolute():
                path = base / path
            if not path.is_file():
                raise SystemExit(f"plan: no brief file for lane {name}: {path}")
            task = path.read_text(encoding="utf-8").strip()
        if not task:
            raise SystemExit(f"plan: lane {name} has neither task nor brief")
        out.append((name, task, entry))
    return out


def _spawn(name: str, task: str, entry: dict, spec: dict, repo: str, plan_id: str) -> int:
    argv = [sys.executable, str(Path(__file__).resolve()), name, task, "--repo", repo,
            "--plan", plan_id]
    for ac_id in _ac_list(entry.get("acs") or []):
        argv += ["--acs", ac_id]
    for key, flag in (("provider", "--provider"), ("model", "--model"), ("thinking", "--thinking"),
                      ("autonomy", "--autonomy"), ("feature", "--feature"), ("group", "--feature"),
                      ("max_usd", "--max-usd"), ("max_turns", "--max-turns"),
                      ("idle_timeout", "--idle-timeout")):
        value = entry.get(key, spec.get(key))
        if value not in (None, ""):
            argv += [flag, str(value)]
    for pattern in entry.get("touch") or spec.get("touch") or []:
        argv += ["--touch", str(pattern)]
    child = subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, start_new_session=True, cwd=str(Path.home()))
    return child.pid


def _wait_names(names: list, timeout: int, grace: int = 30) -> list:
    """Block until every named lane reaches a terminal state; return the ones that are not.

    A lane whose record does not exist yet is PENDING, not finished: the child writes its record a moment
    after it is spawned, and treating the gap as done made the second wave start before the first ended —
    measured, lane `b` started nine seconds before lane `a` finished.
    """
    started = time.monotonic()
    deadline = started + timeout
    while True:
        pending, missing = [], []
        for name in names:
            record = read_json(hermes_home() / "lanes" / name / "lane.json")
            if record is None:
                missing.append(name)
                continue
            state = str(record.get("state") or "")
            if record.get("closed_at") or state in PLAN_TERMINAL:
                continue
            pending.append(name)
        if not pending and not missing:
            return []
        if missing and not pending and time.monotonic() - started > grace:
            return missing
        if time.monotonic() > deadline:
            return pending + missing
        time.sleep(2)


PLAN_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def _plan_gates(spec: dict, lanes: list) -> list:
    """The commands that decide the run, read from the plan and nowhere else.

    A gate runs in the MERGED tree, so a command attached to one lane would answer for the whole
    repository — that is why a lane-level `gates` is refused instead of merged. Silence is worse:
    a key that is read by nobody is a lie in the file.
    """
    gates = spec.get("gates") or []
    if not isinstance(gates, list):
        raise SystemExit("plan: gates must be a list of commands")
    out = []
    for command in gates:
        text = str(command).strip()
        if not text:
            raise SystemExit("plan: an empty gate command")
        if text not in out:
            out.append(text)
    for name, _, entry in lanes:
        if entry.get("acs"):
            bad = _ac_problems(_ac_list(entry.get("acs") or []))
            if bad:
                raise SystemExit(f"plan: lane {name} names criteria that are not ids: {', '.join(bad)}")
        if entry.get("gates"):
            raise SystemExit(f"plan: lane {name} carries gates — gates belong to the plan, "
                             "because a gate runs in the merged tree")
    return out


def _plan_acs(lanes: list, repo: str) -> dict:
    """Which criteria each lane answers, checked against the requirements file before any spend.

    A typo in an id is invisible until the gate refuses the whole run, and a run whose requirements
    file does not exist has nothing to answer for: both are refused here, at open.
    """
    declared = {}
    for name, _, entry in lanes:
        ids = _ac_list(entry.get("acs") or [])
        if ids:
            declared[name] = ids
    if not declared:
        return {}
    path = spec_path(repo)
    criteria = spec_criteria(path)
    if not criteria:
        raise SystemExit(f"plan: lanes declare criteria but {path} holds none — write the requirements "
                         "file before the run, as templates/requirements.md shows")
    known = {ac_id for ac_id, _, _ in criteria}
    unknown = sorted({ac_id for ids in declared.values() for ac_id in ids if ac_id not in known})
    if unknown:
        raise SystemExit(f"plan: declared criteria missing from {path}: {', '.join(unknown)}")
    return declared


def _write_plan_snapshot(plan_id: str, spec: dict, repo: str, gates: list, lanes: list) -> Path:
    """Keep the run's own copy of the plan, so `/tmp` cannot take the gates with it.

    The orchestrator writes its plan under `<parent>/.run/<repo>/`, and one cleanup cut a task file
    out from under a live run. `gate --plan <id>` reads this snapshot, never the file the run was
    opened from.
    """
    folder = hermes_home() / "plans" / plan_id
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / "plan.json"
    snapshot = {
        "id": plan_id,
        "repo": repo,
        "gates": list(gates),
        "lanes": [name for name, _, _ in lanes],
        "acs": {name: _ac_list(entry.get("acs") or []) for name, _, entry in lanes},
        "waves": spec.get("waves") or None,
        "mutation": bool(spec.get("mutation")),
        "opened_at": int(time.time()),
    }
    path.write_text(json.dumps(snapshot, indent=2) + "\n", encoding="utf-8")
    return path


def plan(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="pi-lane plan")
    parser.add_argument("file")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--timeout", type=int, default=3600, help="seconds to wait per wave")
    args = parser.parse_args(argv)
    path = Path(args.file).expanduser()
    if not path.is_file():
        print(f"plan: no such file: {path}", file=sys.stderr)
        return 1
    try:
        spec = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as error:
        print(f"plan: not JSON — {error}", file=sys.stderr)
        return 1
    base = path.parent
    lanes = _plan_lanes(spec, base)
    repo = str(spec.get("repo") or "")
    if not repo:
        print("plan: no repository", file=sys.stderr)
        return 1
    waves = spec.get("waves")
    if not isinstance(waves, list) or not waves:
        waves = [None]  # one wave, every lane at once
    known = {name for name, _, _ in lanes}
    if waves != [None]:
        flat = [name for wave in waves for name in wave]
        if sorted(flat) != sorted(known):
            print("plan: waves and lanes do not name the same lanes", file=sys.stderr)
            return 1
    gates = _plan_gates(spec, lanes)
    declared = _plan_acs(lanes, repo)
    plan_id = str(spec.get("id") or f"{Path(repo).name}-{time.strftime('%H%M%S')}")
    if not PLAN_ID_RE.match(plan_id):
        print("plan: an id holds letters, digits, dot, dash and underscore only", file=sys.stderr)
        return 1
    snapshot = _write_plan_snapshot(plan_id, spec, repo, gates, lanes)
    by_name = {name: (task, entry) for name, task, entry in lanes}
    opened = []
    for wave in waves:
        names = [name for name, _, _ in lanes] if wave is None else [str(item) for item in wave]
        for name in names:
            task, entry = by_name[name]
            opened.append({"lane": name, "pid": _spawn(name, task, entry, spec, repo, plan_id)})
        if wave is not None:
            stuck = _wait_names(names, args.timeout)
            for item in opened:
                item.setdefault("wave", names.index(item["lane"]) if item["lane"] in names else None)
            if stuck:
                print(f"plan: wave stuck after {args.timeout}s: {', '.join(stuck)}", file=sys.stderr)
                break
    if args.json:
        print(json.dumps({"plan": plan_id, "opened": opened}, ensure_ascii=False))
    else:
        print(f"plan {plan_id}: opened {len(opened)} lane(s) in {Path(repo).name}")
        for item in opened:
            print(f"  {item['lane']:16s} pid {item['pid']}")
        if gates:
            print(f"gates: {len(gates)}, kept in {snapshot} — `pi-lane gate --plan {plan_id}`")
        else:
            print("gates: none — a plan without gates leaves the checks to the orchestrator's memory")
        print("check them with `pi-lane status` or `pi-lane report`")
    return 0


# --- 77_mutation.py ----------------------------------------------------
"""mutate: does the suite notice when the code is wrong?

A green suite says the tests pass; it says nothing about whether they would fail if the code were
different. Mutation testing answers that the cheap way: change one thing in the source, run the tests,
and require them to break. A mutant that survives is a hole with a file and a line.

    pi-lane mutate --plan <id> [--cmd "python3 -m unittest discover -s tests"]
                   [--max 12] [--timeout 900] [--min 1.0] [--files "music/*.py"]

Rules that keep it honest:

- **The tree is read-only for the run.** A dirty tree is refused, every file is restored byte for byte
  after its mutant, and the run ends with the same sha it started at. A mutation tool that leaves a
  half-edit behind is worse than none.
- **One mutant, one test run.** The operators are the ones a wrong thought usually flips: `==`/`!=`,
  `<`/`<=`, `>`/`>=`, `and`/`or`.
- **A non-zero exit is a kill**, including a crash: the suite noticed. A timeout is a survival, because
  a suite that hangs has not judged anything.
- `--min` is the score a run must reach; the default is every sampled mutant killed. The sample is
  bounded by `--max`, because 89 tests × 40 mutants is an hour.
"""
import os
import subprocess
import sys
import time
from pathlib import Path

MUTATION_RULES = (
    (" == ", " != "),
    (" != ", " == "),
    (" <= ", " < "),
    (" >= ", " > "),
    (" < ", " <= "),
    (" > ", " >= "),
    (" and ", " or "),
    (" or ", " and "),
)
MUTATION_SKIP_DIRS = {".git", ".worktrees", "node_modules", "__pycache__", "tests", "gates",
                      ".venv", "venv", "build", "dist"}


def _mutation_targets(repo: str, pattern: str) -> list:
    root = Path(repo)
    files = sorted(root.glob(pattern)) if pattern else sorted(root.rglob("*.py"))
    out = []
    for path in files:
        if not path.is_file():
            continue
        if any(part in MUTATION_SKIP_DIRS for part in path.parts):
            continue
        out.append(path)
    return out


def _mutation_candidates(path: Path) -> list:
    """One candidate per line: an operator a wrong thought would flip, in code and not in prose.

    A docstring is where the first run of this check produced three false survivors: `"artist and title"`
    sits in prose, nothing tests it, and the score blamed the tests. So docstrings, comments and imports
    are skipped — a mutant must land on behaviour, or the score measures the checker instead of the code.
    """
    out = []
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    fence_marks = ('"""', "'''")
    in_doc = False
    for number, line in enumerate(text.splitlines(), 1):
        stripped = line.strip()
        opened = sum(line.count(mark) for mark in fence_marks)
        if opened:
            # A line holding a fence is a docstring boundary, a one-line docstring, or prose inside one.
            # None of them is behaviour, and a mutant there measures the checker, not the tests.
            if opened % 2:
                in_doc = not in_doc
            continue
        if in_doc or not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith(("import ", "from ")):
            continue
        for before, after in MUTATION_RULES:
            if before in line:
                out.append((number, before, after))
                break
    return out


def mutate(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="pi-lane mutate")
    parser.add_argument("--plan", default="", help="the plan id whose lanes this check belongs to")
    parser.add_argument("--repo", default="", help="the repository; taken from the plan's lanes when omitted")
    parser.add_argument("--cmd", action="append", default=[],
                        help="the test command to run per mutant; defaults to the plan's first gate")
    parser.add_argument("--files", default="", help="a glob inside the repository, e.g. 'music/*.py'")
    parser.add_argument("--max", type=int, default=12, help="how many mutants to try")
    parser.add_argument("--timeout", type=int, default=900, help="seconds per mutant")
    parser.add_argument("--min", type=float, default=1.0, help="score below which the check fails")
    args = parser.parse_args(argv)

    records = [record for record in lane_records()
               if args.plan and record.get("plan") == args.plan and not record.get("closed_at")]
    repo = os.path.realpath(args.repo) if args.repo else ""
    command = ""
    if args.plan:
        snapshot = read_json(hermes_home() / "plans" / args.plan / "plan.json") or {}
        gates = snapshot.get("gates") or []
        command = str(gates[0]) if gates else ""
        if not repo:
            repos = {os.path.realpath(str(record.get("repo") or "")) for record in records}
            repos.discard("")
            if len(repos) == 1:
                repo = repos.pop()
    if args.cmd:
        command = str(args.cmd[0])
    if not command:
        command = "python3 -m unittest discover -s tests"
    if not repo:
        print("pi-lane mutate: pass --repo or a plan whose lanes name one", file=sys.stderr)
        return 2
    if not Path(repo, ".git").exists():
        print(f"pi-lane mutate: not a git repository: {repo}", file=sys.stderr)
        return 1

    rc, head, err = _git(repo, "rev-parse", "HEAD")
    if rc != 0:
        print(f"{repo}: git says: {err}", file=sys.stderr)
        return 1
    # Tracked changes only: a stray `__pycache__` is not a half-edited file, and the subprocess below is
    # told not to write bytecode so the tree it leaves is the tree it found.
    rc, dirty, _ = _git(repo, "status", "--porcelain", "--untracked-files=no")
    if dirty.strip():
        print("pi-lane mutate: the tree is dirty — commit first, the run must end at the sha it started at",
              file=sys.stderr)
        return 1
    unmerged = []
    for record in records:
        branch = str(record.get("branch") or "")
        if not branch:
            continue
        rc, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, "HEAD")
        if rc != 0:
            unmerged.append(str(record.get("lane")))
    if unmerged:
        print(f"refusing: not merged into HEAD ({head[:7]}): {', '.join(sorted(unmerged))}", file=sys.stderr)
        return 1

    candidates = []
    for path in _mutation_targets(repo, args.files):
        for number, before, after in _mutation_candidates(path):
            candidates.append((path, number, before, after))
            if len(candidates) >= args.max:
                break
        if len(candidates) >= args.max:
            break
    if not candidates:
        print("pi-lane mutate: no mutation point found — widen --files", file=sys.stderr)
        return 1

    print(f"$ {command}   (per mutant, in {repo})")
    results = []
    for path, number, before, after in candidates:
        original = path.read_text(encoding="utf-8")
        lines = original.splitlines(keepends=True)
        index = number - 1
        mutated = lines[index].replace(before, after, 1)
        label = f"{str(path.relative_to(Path(repo)))}:{number}"
        started = time.time()
        verdict = "survived"
        try:
            lines[index] = mutated
            path.write_text("".join(lines), encoding="utf-8")
            try:
                env = dict(os.environ)
                env["PYTHONDONTWRITEBYTECODE"] = "1"
                done = subprocess.run(command, shell=True, cwd=repo, capture_output=True, text=True,
                                      timeout=args.timeout, env=env)
                verdict = "killed" if done.returncode != 0 else "survived"
                tail = ((done.stdout or "") + (done.stderr or "")).strip().splitlines()[-3:]
            except subprocess.TimeoutExpired:
                verdict = "survived"
                tail = [f"timeout after {args.timeout}s — a suite that hangs judged nothing"]
        finally:
            path.write_text(original, encoding="utf-8")
            restored = path.read_text(encoding="utf-8") == original
        if not restored:
            print(f"{label}: could not restore the file — stop and check the tree", file=sys.stderr)
            return 1
        seconds = int(time.time() - started)
        print(f"{label:44s} {before.strip():3s} → {after.strip():3s}  {verdict:8s} {seconds:3d}s")
        if verdict != "killed":
            for line in tail:
                print(f"    {line}")
        results.append({"site": label, "from": before.strip(), "to": after.strip(),
                        "verdict": verdict, "seconds": seconds})

    killed = sum(1 for item in results if item["verdict"] == "killed")
    score = round(killed / len(results), 4) if results else 0.0
    ok = score >= args.min
    check = {"ok": ok, "sha": head, "ran_at": int(time.time()), "score": score,
             "killed": killed, "total": len(results), "cmd": command,
             "survivors": [item["site"] for item in results if item["verdict"] != "killed"]}
    for record in records:
        record["mutation"] = check
        write_record(hermes_home() / "lanes" / str(record.get("lane")), record)

    rc, after_head, _ = _git(repo, "rev-parse", "HEAD")
    if after_head != head:
        print(f"the tree moved during the run: {head[:7]} → {after_head[:7]}", file=sys.stderr)
        return 1
    print(f"mutation score {killed}/{len(results)} at {head[:7]}"
          + (f" — survivors: {', '.join(check['survivors'])}" if check["survivors"] else " — every sampled mutant killed"))
    return 0 if ok else 1


# --- 78_spec.py --------------------------------------------------------
"""spec: the requirement layer a run has to answer for.

The task says what to build; nothing in a lane brief says what proves it. Six criteria in a plan, six
`gates` commands, and the only link between them is prose nobody greps. This part adds the file, the
check and the coverage search, so a criterion that no test proves stops the run at the gate instead of
turning up in a review a week later.

    spec/requirements.md      AC1  WHEN … THE SYSTEM SHALL …      written once, by the orchestrator
    spec/tasks.md             lane → the files it owns → the criteria it answers (generated)
    spec/design.md            what the slices must agree on (the contract lane writes it)

    pi-lane spec check  [--repo P] [--file F]
    pi-lane spec cover  [--repo P] [--file F] [--acs AC1,AC3] [--json]
    pi-lane spec tasks  <plan.json> [--write]

`check` reads the requirements file; `cover` looks for each id in `tests/` and `gates/`; `tasks` writes
the table a reviewer reads. A lane declares the ids it answers (`--acs AC1,AC3`, or `"acs": [...]` in a
plan), reports them back in its `RESULT`, and `gate` refuses to record a check while one of them is
covered nowhere in the merged tree.
"""
import json
import os
import re
from pathlib import Path

REQUIREMENTS_FILE = "spec/requirements.md"
DESIGN_FILE = "spec/design.md"
TASKS_FILE = "spec/tasks.md"
AC_ID_RE = re.compile(r"^AC\d+$")
AC_LINE_RE = re.compile(r"^\s*(AC\d+)\b(.*)$")
EARS_TRIGGERS = ("WHEN", "WHILE", "WHERE", "IF")
COVER_DIRS = ("tests", "gates")
SKIP_DIRS = {".git", ".worktrees", "node_modules", "__pycache__", ".venv", "venv", ".mypy_cache"}


def spec_path(repo: str, file: str = "") -> Path:
    return Path(file).expanduser() if file else Path(repo) / REQUIREMENTS_FILE


def spec_criteria(path: Path) -> list:
    """Every criterion line as (id, text, line number). Prose between them is not a criterion."""
    out = []
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    for number, line in enumerate(text.splitlines(), 1):
        match = AC_LINE_RE.match(line)
        if not match:
            continue
        out.append((match.group(1), match.group(2).strip(), number))
    return out


def spec_problems(criteria: list, path: Path) -> list:
    """What makes this file useless as ground truth, in the order a person would fix it."""
    problems = []
    if not path.is_file():
        return [f"no requirements file at {path}"]
    if not criteria:
        return [f"{path} carries no criterion — one line per AC<n>, as in templates/requirements.md"]
    seen = {}
    for ac_id, text, number in criteria:
        if ac_id in seen:
            problems.append(f"line {number}: {ac_id} already used on line {seen[ac_id]}")
        else:
            seen[ac_id] = number
        if not text:
            problems.append(f"line {number}: {ac_id} has no text")
            continue
        upper = text.upper()
        if "SHALL" not in upper:
            problems.append(f"line {number}: {ac_id} states no SHALL — a criterion names an observable result")
        if not any(trigger in upper.split() for trigger in EARS_TRIGGERS):
            problems.append(f"line {number}: {ac_id} names no trigger "
                            f"({'/'.join(EARS_TRIGGERS)} … THE SYSTEM SHALL …)")
    return problems


def _cover_files(repo: str):
    """Every file that can carry a proof: tests/, gates/ and the test modules at the root."""
    root = Path(repo)
    if not root.is_dir():
        return
    candidates = []
    for name in COVER_DIRS:
        base = root / name
        if base.is_dir():
            candidates.extend(sorted(base.rglob("*")))
    candidates.extend(sorted(root.glob("test_*.py")))
    for path in candidates:
        if not path.is_file():
            continue
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        yield path


def _ac_pattern(ac_id: str):
    return re.compile(rf"(?<![A-Za-z0-9]){re.escape(ac_id)}(?![0-9])", re.IGNORECASE)


def _def_name(line: str) -> str:
    """The name a `def` or `class` line declares, else an empty string."""
    match = re.match(r"\s*(?:async\s+)?(?:def|class)\s+([A-Za-z_]\w*)", line)
    return match.group(1) if match else ""


def _is_comment(line: str) -> bool:
    stripped = line.strip()
    return (not stripped or stripped.startswith("#") or stripped.startswith("//")
            or stripped.startswith("*") or stripped.startswith('"') or stripped.startswith("'")
            or stripped.startswith("--"))


def spec_scan(repo: str, ids: list) -> dict:
    """Where each id is PROVEN, and where it is only mentioned.

    A mention is not a proof. Measured on one run: `library.sync` never called `store.scan` while the
    criterion that says it must was "covered" — the id sat in a comment beside a test that proved
    something else, and the run needed a fifth lane after closing. So an id counts only when it carries
    a test of its own: `def test_ac3_resolver_failure_is_recorded`, case-insensitive, in the name. In a
    `gates/` script — a file that exists to check criteria — a line that is not a comment counts.
    """
    proof = {ac_id: "" for ac_id in ids}
    mention = {ac_id: "" for ac_id in ids}
    if not ids:
        return {"proof": proof, "mention": mention}
    patterns = {ac_id: _ac_pattern(ac_id) for ac_id in ids}
    for path in _cover_files(repo):
        under_gates = "gates" in path.parts
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        try:
            relative = str(path.relative_to(Path(repo)))
        except ValueError:
            relative = str(path)
        for number, line in enumerate(text.splitlines(), 1):
            if _is_comment(line):
                continue
            name = _def_name(line)
            for ac_id, pattern in patterns.items():
                if not pattern.search(line):
                    continue
                site = f"{relative}:{number}"
                if pattern.search(name) or under_gates:
                    if not proof[ac_id]:
                        proof[ac_id] = site
                elif not mention[ac_id]:
                    mention[ac_id] = site
    return {"proof": proof, "mention": mention}


def spec_summary(repo: str, ids: list) -> dict:
    """The one shape every reader uses: declared, covered (proven), unproven, missing."""
    scan = spec_scan(repo, ids)
    proof, mention = scan["proof"], scan["mention"]
    covered = [ac_id for ac_id in ids if proof.get(ac_id)]
    unproven = [ac_id for ac_id in ids if not proof.get(ac_id) and mention.get(ac_id)]
    missing = [ac_id for ac_id in ids if not proof.get(ac_id) and not mention.get(ac_id)]
    return {"declared": list(ids), "covered": covered, "unproven": unproven, "missing": missing,
            "where": {ac_id: proof[ac_id] for ac_id in covered},
            "mentioned": {ac_id: mention[ac_id] for ac_id in unproven}}


def spec_check(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="pi-lane spec check")
    parser.add_argument("--repo", default=".", help="the repository that holds spec/")
    parser.add_argument("--file", default="", help="read this file instead of spec/requirements.md")
    args = parser.parse_args(argv)
    repo = os.path.realpath(args.repo)
    path = spec_path(repo, args.file)
    criteria = spec_criteria(path)
    problems = spec_problems(criteria, path)
    if problems:
        for problem in problems:
            print(f"spec: {problem}", file=sys.stderr)
        return 1
    ids = [ac_id for ac_id, _, _ in criteria]
    print(f"spec ok — {len(ids)} criterion(s): {', '.join(ids)}")
    return 0


def spec_cover(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="pi-lane spec cover")
    parser.add_argument("--repo", default=".", help="the repository that holds spec/ and tests/")
    parser.add_argument("--file", default="", help="read this file instead of spec/requirements.md")
    parser.add_argument("--acs", default="", help="only these ids, comma separated (a lane's slice)")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    repo = os.path.realpath(args.repo)
    path = spec_path(repo, args.file)
    criteria = spec_criteria(path)
    problems = spec_problems(criteria, path)
    if problems:
        for problem in problems:
            print(f"spec: {problem}", file=sys.stderr)
        return 1
    wanted = [ac_id for ac_id, _, _ in criteria]
    if args.acs:
        wanted = [piece.strip().upper() for piece in args.acs.split(",") if piece.strip()]
        unknown = [ac_id for ac_id in wanted if ac_id not in {c[0] for c in criteria}]
        if unknown:
            print(f"spec: not in {path}: {', '.join(unknown)}", file=sys.stderr)
            return 1
    summary = spec_summary(repo, wanted)
    unresolved = summary["missing"] + summary["unproven"]
    if args.json:
        print(json.dumps(summary, ensure_ascii=False))
        return 0 if not unresolved else 1
    for ac_id in summary["covered"]:
        print(f"{ac_id:6s} covered   {summary['where'][ac_id]}")
    for ac_id in summary["unproven"]:
        print(f"{ac_id:6s} MENTIONED — {summary['mentioned'][ac_id]} names it, but no test carries it "
              "in its name and no gate script calls it")
    for ac_id in summary["missing"]:
        print(f"{ac_id:6s} NOT COVERED — no test or gate script names it in {', '.join(COVER_DIRS)}/")
    print(f"coverage {len(summary['covered'])}/{len(wanted)}"
          + (f" · {len(summary['unproven'])} mentioned only" if summary["unproven"] else ""))
    return 0 if not unresolved else 1


def spec_tasks(argv: list) -> int:
    """Generate `spec/tasks.md`: which lane owns which files and answers which criteria.

    The plan file already carries the split; this turns it into the one page a reviewer keeps open.
    Unknown ids are refused here, before a lane is opened, because a typo in an id is invisible until
    the gate refuses the whole run.
    """
    parser = argparse.ArgumentParser(prog="pi-lane spec tasks")
    parser.add_argument("file", help="the plan file")
    parser.add_argument("--write", action="store_true", help="write <repo>/spec/tasks.md")
    args = parser.parse_args(argv)
    plan_file = Path(args.file).expanduser()
    try:
        spec = json.loads(plan_file.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        print(f"spec tasks: cannot read {plan_file} — {error}", file=sys.stderr)
        return 1
    repo = str(spec.get("repo") or "")
    if not repo or not Path(repo).is_dir():
        print("spec tasks: the plan names no repository", file=sys.stderr)
        return 1
    lanes = spec.get("lanes") or []
    if not isinstance(lanes, list) or not lanes:
        print("spec tasks: the plan names no lanes", file=sys.stderr)
        return 1
    criteria = spec_criteria(spec_path(repo))
    known = [ac_id for ac_id, _, _ in criteria]
    declared = []
    for entry in lanes:
        declared.extend(str(item).upper() for item in (entry.get("acs") or []))
    unknown = sorted({ac_id for ac_id in declared if ac_id not in known})
    if unknown:
        print(f"spec tasks: no such criterion in {spec_path(repo)}: {', '.join(unknown)}", file=sys.stderr)
        return 1

    rows = ["# Tasks — lane, files, criteria", "",
            f"Generated from `{plan_file.name}` by `pi-lane spec tasks`. Do not edit: change the plan.", "",
            "| Lane | Files it owns | Criteria |", "|---|---|---|"]
    for entry in lanes:
        files = ", ".join(f"`{item}`" for item in (entry.get("touch") or [])) or "—"
        acs = ", ".join(str(item).upper() for item in (entry.get("acs") or [])) or "—"
        rows.append(f"| `{entry.get('name')}` | {files} | {acs} |")
    unclaimed = [ac_id for ac_id in known if ac_id not in {item.upper() for item in declared}]
    if unclaimed:
        rows += ["", f"Unclaimed criteria — no lane answers for them: {', '.join(unclaimed)}"]
    text = "\n".join(rows) + "\n"
    if args.write:
        target = Path(repo) / TASKS_FILE
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")
        print(f"spec tasks: wrote {target} ({len(lanes)} lane(s), {len(declared)} claimed id(s))")
        if unclaimed:
            print(f"spec tasks: {len(unclaimed)} criteria claimed by no lane: {', '.join(unclaimed)}")
            return 1
        return 0
    print(text, end="")
    return 0


def spec(argv: list) -> int:
    if not argv or argv[0] not in ("check", "cover", "tasks"):
        print("usage: pi-lane spec check|cover|tasks …", file=sys.stderr)
        return 2
    return {"check": spec_check, "cover": spec_cover, "tasks": spec_tasks}[argv[0]](argv[1:])


# --- 79_holdout.py -----------------------------------------------------
"""holdout: the acceptance scenarios the writer never sees.

A gate lives in the repository, so the agent that writes the code reads it, and a measured run showed what
that costs: tests named after the criteria, asserting something else, all green. The holdout is the other
half of the acceptance — scenarios kept outside the repository, written before any lane opens, run against
the merged tree and recorded on the lanes that carry the plan.

    $HERMES_HOME/holdout/<plan>/          one executable per scenario: its name is its label
    01-sync-prints-the-summary.py         exit 0 = the behaviour holds, anything else = it does not
    02-dry-run-changes-nothing.sh

    pi-lane holdout <plan> [--dir PATH] [--timeout SECONDS] [--json]

Rules that make it a check and not a second wish list:

- The writing agent never reads `$HERMES_HOME`: the scenarios are not in its worktree and not in its brief.
- A scenario is a program, not prose: it starts the real CLI or imports the package and asserts what a
  reader of the requirement would assert. Exit code is the verdict, printed lines are the evidence.
- It runs in the MERGED tree, after the lane branches are in — the same tree `gate` runs in — so a scenario
  cannot bless a worktree that was never merged.
- `close --auto` refuses without a green holdout at HEAD. A merge nobody verified stays a merge a person
  asked for.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOLDOUT_DIR = "holdout"
SCENARIO_SUFFIXES = (".py", ".sh")


def holdout_folder(plan_id: str, path: str = "") -> Path:
    return Path(path).expanduser() if path else hermes_home() / HOLDOUT_DIR / plan_id


def holdout_scenarios(folder: Path) -> list:
    """Every executable scenario in the folder, in name order — the name carries the label."""
    if not folder.is_dir():
        return []
    out = []
    for path in sorted(folder.iterdir()):
        if not path.is_file() or path.name.startswith((".", "_")):
            continue
        if path.suffix not in SCENARIO_SUFFIXES:
            continue
        out.append(path)
    return out


def _run_scenario(path: Path, repo: str, timeout: int) -> dict:
    """One scenario, in the merged tree, with its exit code and the tail of what it printed."""
    if path.suffix == ".py":
        argv = [sys.executable, str(path)]
    elif os.access(path, os.X_OK):
        argv = [str(path)]
    else:
        argv = ["sh", str(path)]
    env = dict(os.environ)
    env["HOLDOUT_REPO"] = repo
    started = time.time()
    try:
        done = subprocess.run(argv, cwd=repo, capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return {"name": path.name, "exit": 124, "seconds": timeout, "tail": f"timeout after {timeout}s"}
    except OSError as error:
        return {"name": path.name, "exit": 126, "seconds": 0, "tail": str(error)}
    output = ((done.stdout or "") + (done.stderr or "")).strip()
    tail = "\n".join(output.splitlines()[-15:])
    return {"name": path.name, "exit": done.returncode, "seconds": int(time.time() - started), "tail": tail}


def holdout(argv: list) -> int:
    parser = argparse.ArgumentParser(prog="pi-lane holdout")
    parser.add_argument("plan", nargs="?", default="", help="the plan id whose lanes this acceptance covers")
    parser.add_argument("--dir", default="", help="read scenarios from here instead of $HERMES_HOME/holdout/<plan>")
    parser.add_argument("--repo", default="", help="run against this repository when no lane carries the plan")
    parser.add_argument("--timeout", type=int, default=600, help="seconds per scenario")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    if not args.plan and not args.dir:
        print("pi-lane holdout: pass a plan id or --dir", file=sys.stderr)
        return 2

    folder = holdout_folder(args.plan, args.dir)
    scenarios = holdout_scenarios(folder)
    if not scenarios:
        print(f"holdout: no scenario in {folder} — write one per criterion a reader would check, "
              "before any lane opens", file=sys.stderr)
        return 1

    records = [record for record in lane_records()
               if args.plan and record.get("plan") == args.plan and not record.get("closed_at")]
    repo = os.path.realpath(args.repo) if args.repo else ""
    if not repo:
        repos = {os.path.realpath(str(record.get("repo") or "")) for record in records}
        repos.discard("")
        if len(repos) != 1:
            print(f"holdout: {len(repos)} repositories among the lanes of {args.plan}; pass --repo",
                  file=sys.stderr)
            return 1
        repo = repos.pop()
    if not Path(repo, ".git").exists():
        print(f"holdout: not a git repository: {repo}", file=sys.stderr)
        return 1

    rc, head, err = _git(repo, "rev-parse", "HEAD")
    if rc != 0:
        print(f"{repo}: git says: {err}", file=sys.stderr)
        return 1

    # The same refusal as `gate`: a scenario that runs beside unmerged work proves nothing about the tree.
    unmerged = []
    for record in records:
        branch = str(record.get("branch") or "")
        if not branch:
            continue
        rc, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, "HEAD")
        if rc != 0:
            unmerged.append(str(record.get("lane")))
    if unmerged:
        print(f"refusing: not merged into HEAD ({head[:7]}): {', '.join(sorted(unmerged))}", file=sys.stderr)
        return 1

    results = []
    for path in scenarios:
        result = _run_scenario(path, repo, args.timeout)
        results.append(result)
        if not args.json:
            mark = "ok  " if result["exit"] == 0 else f"exit {result['exit']}"
            print(f"{path.name:44s} {mark:8s} {result['seconds']:4d}s")
            if result["tail"]:
                for line in result["tail"].splitlines():
                    print(f"    {line}")
    ok = all(result["exit"] == 0 for result in results)
    check = {"ok": ok, "sha": head, "ran_at": int(time.time()), "dir": str(folder),
             "scenarios": [{"name": r["name"], "exit": r["exit"]} for r in results]}

    for record in records:
        record["holdout"] = check
        write_record(hermes_home() / "lanes" / str(record.get("lane")), record)

    if args.json:
        print(json.dumps(check, ensure_ascii=False))
    else:
        failed = [r["name"] for r in results if r["exit"] != 0]
        if failed:
            print(f"holdout FAILED at {head[:7]}: {', '.join(failed)}")
        else:
            print(f"holdout ok — {len(results)} scenario(s) at {head[:7]}, recorded on {len(records)} lane(s)")
    return 0 if ok else 1


