#!/usr/bin/env python3
"""pi-lane — run one headless pi lane, answer its questions, record what it says.

    pi-lane <lane> <repo> "<task>" [--provider P] [--model M] [--thinking L]
            [--question-timeout SECONDS]

A lane is a worktree plus one `pi --mode rpc` run:

    <repo>/.worktrees/<lane>                  branch lane/<lane>
    $HERMES_HOME/lanes/<lane>/lane.json       record: task, state, pid, session
    $HERMES_HOME/lanes/<lane>/events.jsonl    raw pi event stream
    $HERMES_HOME/lanes/<lane>/question.json   the question pi waits on
    $HERMES_HOME/lanes/<lane>/answer.json     the answer, written by the panel
    $HERMES_HOME/lanes/<lane>/stderr.txt      stderr

RPC mode is what makes questions work: an extension dialog arrives as an
`extension_ui_request`, the runner parks it in question.json, and the panel
writes answer.json. No tmux, no pty.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path
from typing import NoReturn

DIALOG_METHODS = {"select", "confirm", "input", "editor"}
POLL_SECONDS = 0.3
ENV_KEYS = (
    "NVIDIA_API_KEY",
    "DEEPSEEK_API_KEY",
    "OPENROUTER_API_KEY",
    "OPENCODE_API_KEY",
    "OPENCODE_GO_API_KEY",
    "ANTHROPIC_API_KEY",
)
# pi names the opencode credential OPENCODE_API_KEY; Hermes stores the same value as
# OPENCODE_GO_API_KEY. Hand pi the name it reads, or the provider looks unconfigured.
ALIASES = {"OPENCODE_GO_API_KEY": "OPENCODE_API_KEY"}
DEFAULT_PROVIDER = "nvidia"
DEFAULT_MODEL = "nvidia/nemotron-3.5-super-vl-120b-a12b"
DEFAULT_THINKING = "medium"
LANE_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def hermes_home() -> Path:
    return Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")


def fail(message: str) -> NoReturn:
    print(f"pi-lane: {message}", file=sys.stderr)
    raise SystemExit(2)


def apply_aliases() -> None:
    """Hermes names a credential differently from pi; hand pi the name it reads.

    Both env branches end here: a spawn that already carries the Hermes name returns early,
    and without this pass ``opencode-go`` stays unconfigured while the key sits in the env.
    """
    for source, target in ALIASES.items():
        value = (os.environ.get(source) or "").strip()
        if value and not (os.environ.get(target) or "").strip():
            os.environ[target] = value


def load_env_keys() -> None:
    """Put the provider keys into this process, for the pi run it starts.

    Hermes's own secret scope comes first: run the runner with Hermes's interpreter and the keys
    arrive profile-scoped, exactly as Hermes reads them. A plain `python3` has no such scope, so the
    fallback parses the profile's `.env` — the one file the keys live in when no scope is installed.
    """
    try:
        from agent.secret_scope import get_secret

        for name in ENV_KEYS:
            value = (get_secret(name) or "").strip()
            if value and not os.environ.get(name):
                os.environ[name] = value
    except Exception:
        pass
    # No early return here. A scope that answers for one provider says nothing about another, and a
    # single unrelated key in the environment — the gateway's own, say — used to stop this fallback
    # before it read the file. The file is the last place a key can come from: read it always.
    env_file = hermes_home() / ".env"
    if not env_file.is_file():
        return
    try:
        lines = env_file.read_text(errors="replace").splitlines()
    except OSError:
        return
    for line in lines:
        name, sep, value = line.partition("=")
        name = name.strip()
        if not sep or name not in ENV_KEYS:
            continue
        value = value.strip()
        target = ALIASES.get(name, name)
        if not os.environ.get(target):
            os.environ[target] = value
    apply_aliases()


def write_record(lane_dir: Path, record: dict) -> None:
    tmp = lane_dir / "lane.json.tmp"
    tmp.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    tmp.replace(lane_dir / "lane.json")


def ensure_excludes(repo: str) -> None:
    """Hide lane scratch from the main checkout without touching tracked files."""
    base = Path(repo) / ".git"
    try:
        done = subprocess.run(
            ["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=10, check=False,
        )
        if done.returncode == 0 and done.stdout.strip():
            base = Path(done.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    info = base / "info"
    info.mkdir(parents=True, exist_ok=True)
    exclude = info / "exclude"
    existing = exclude.read_text(errors="replace").splitlines() if exclude.is_file() else []
    for pattern in ("/.worktrees/", ".thinkrail/"):
        if pattern not in existing:
            with exclude.open("a", encoding="utf-8") as handle:
                handle.write(pattern + "\n")


def pid_alive(pid) -> bool:
    try:
        value = int(pid)
    except (TypeError, ValueError):
        return False
    if value <= 0:
        return False
    try:
        os.kill(value, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, owned by another user
    except OSError:
        return False
    return True


def lane_records() -> list:
    """Every readable lane record, so guards can see what is already running."""
    records = []
    root = hermes_home() / "lanes"
    if not root.is_dir():
        return records
    for path in sorted(root.glob("*/lane.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8", errors="replace"))
        except (OSError, ValueError):
            continue
        if isinstance(record, dict):
            records.append(record)
    return records


# Streaming deltas are 51-68% of the stream and nothing reads them: the runner drives its state from
# message_end, tool_execution_* and the question events, the backend reads the same, and the panel
# shows the last finished message. Keep the delta out of the file unless somebody asks for it.
_DROP_EVENT_TYPES = () if os.environ.get("PI_LANE_KEEP_DELTAS") else ("message_update",)


def _keep_event(line: str) -> bool:
    """True when this raw line belongs in events.jsonl."""
    if not _DROP_EVENT_TYPES:
        return True
    stripped = line.lstrip()
    if not stripped.startswith("{"):
        return True
    for name in _DROP_EVENT_TYPES:
        if f'"type":"{name}"' in stripped or f'"type": "{name}"' in stripped:
            return False
    return True


def assistant_text(event: dict) -> str:
    message = event.get("message") or {}
    if message.get("role") != "assistant":
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return content.strip()
    if not isinstance(content, list):
        return ""
    parts = [p.get("text", "") for p in content if isinstance(p, dict) and p.get("type") == "text"]
    return "\n".join(p for p in parts if p).strip()


def assistant_texts(lane_dir) -> list:
    """The lane's own final texts, oldest first, read from the tail of its event stream."""
    path = Path(lane_dir) / "events.jsonl"
    out: list = []
    try:
        lines = path.read_text(errors="replace").splitlines()[-400:]
    except OSError:
        return out
    for line in lines:
        try:
            event = json.loads(line)
        except Exception:
            continue
        if isinstance(event, dict) and event.get("type") == "message_end":
            text = assistant_text(event)
            if text and text.strip():
                out.append(text.strip())
    return out


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def _git(repo: str, *args: str) -> tuple:
    done = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return done.returncode, done.stdout.strip(), done.stderr.strip()


def _default_branch(repo: str) -> str:
    rc, out, _ = _git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if rc == 0 and out:
        return out.split("/", 1)[-1]
    for candidate in ("main", "master"):
        rc, _, _ = _git(repo, "rev-parse", "--verify", "--quiet", candidate)
        if rc == 0:
            return candidate
    return ""


def _shortstat(repo: str, sha: str) -> tuple:
    rc, out, _ = _git(repo, "show", "--shortstat", "--format=", sha)
    if rc != 0:
        return 0, 0, 0
    files = re.search(r"(\d+) files? changed", out)
    added = re.search(r"(\d+) insertions?\+?\)?", out)
    removed = re.search(r"(\d+) deletions?", out)
    return (
        int(files.group(1)) if files else 0,
        int(added.group(1)) if added else 0,
        int(removed.group(1)) if removed else 0,
    )


def pi_session_dir(worktree: Path) -> Path:
    """Where pi keeps the session of a lane: one folder per worktree path, encoded."""
    key = str(worktree.resolve()).lstrip("/").replace("/", "-")
    return Path.home() / ".pi" / "agent" / "sessions" / f"--{key}--"


def pi_session_files(worktree: Path, session_id: str) -> list:
    folder = pi_session_dir(worktree)
    if not folder.is_dir():
        return []
    return sorted(folder.glob(f"*_{session_id}.jsonl"))


def close_lanes(argv: list) -> int:
    """Close lanes for good: merge their branch, then write the closed marker.

    Nothing lands on the shelf by accident — this is the only path into it.
    """
    parser = argparse.ArgumentParser(prog="pi-lane close")
    parser.add_argument("lanes", nargs="+")
    parser.add_argument("--no-merge", action="store_true", help="record the close without merging")
    parser.add_argument("--reason", default="", help="why it is closed; defaults to the merge")
    parser.add_argument("--keep", action="store_true", help="keep the worktree, branch and lane folder")
    parser.add_argument("--yes", action="store_true", help="confirm the deletion; without it only the plan prints")
    args = parser.parse_args(argv)

    root = hermes_home() / "lanes"
    failed = 0
    for name in args.lanes:
        lane_dir = root / name
        record = read_json(lane_dir / "lane.json")
        if not record:
            print(f"{name}: no such lane", file=sys.stderr)
            failed += 1
            continue
        if record.get("closed_at"):
            print(f"{name}: already closed")
            continue
        repo = str(record.get("repo") or "")
        branch = str(record.get("branch") or f"lane/{name}")
        worktree = Path(str(record.get("worktree") or ""))
        state = str(record.get("state") or "")
        if state == "running" and pid_alive(record.get("pid")):
            print(f"{name}: still running — stop it first", file=sys.stderr)
            failed += 1
            continue

        if not args.yes and not args.no_merge:
            # Say exactly what disappears before anything does.
            default_name = _default_branch(repo) if repo and Path(repo).is_dir() else "?"
            rc_c, commits, _ = _git(worktree, "rev-list", "--count", f"{default_name}..HEAD") if worktree.is_dir() else (1, "0", "")
            rc_d, dirty, _ = _git(str(worktree), "status", "--porcelain") if worktree.is_dir() else (1, "", "")
            changed = len([l for l in dirty.splitlines() if l.strip()])
            size = 0
            if lane_dir.is_dir():
                size = sum(f.stat().st_size for f in lane_dir.rglob("*") if f.is_file())
            print(f"{name}: nothing done yet — this is the plan")
            print(f"  merge   {branch} → {default_name}"
                  + (f" ({commits.strip()} commits)" if worktree.is_dir() else " (no worktree)"))
            print(f"  commit  {changed} uncommitted file(s) from the lane" if changed else "  commit  nothing uncommitted")
            print(f"  delete  worktree {worktree}" if worktree.is_dir() else "  delete  no worktree")
            print(f"  delete  branch {branch}")
            print(f"  delete  folder {lane_dir} ({size // 1024}K)")
            sessions = pi_session_files(worktree, str(record.get("session_id") or "")) if worktree.is_dir() else []
            session_kb = sum(f.stat().st_size for f in sessions) // 1024
            print(f"  delete  pi session {pi_session_dir(worktree)} ({session_kb}K)" if sessions or worktree.is_dir()
                  else "  delete  no pi session")
            print(f"  keep    one receipt line in {(root / 'closed.jsonl')}")
            print("")
            print("  Nothing is lost. The work lands in the main branch as commits, and every one of")
            print("  them stays in the history: it can be shown, copied or turned into a new branch")
            print("  later. The worktree, the branch and the folder go only to free space and to keep")
            print("  the panel free of dead lanes — the code itself lives on in the main branch.")
            print("")
            print(f"  rerun with --yes to carry it out")
            continue

        # A lane does not commit, so its work is still uncommitted here: commit it on the lane
        # branch before the merge, or the merge would carry nothing.
        if worktree.is_dir():
            rc_s, dirty, _ = _git(str(worktree), "status", "--porcelain")
            if rc_s == 0 and dirty.strip():
                _git(str(worktree), "add", "-A")
                summary = str(record.get("task") or name).strip().splitlines()[0][:70]
                _git(
                    str(worktree), "-c", "user.name=pi-lane", "-c", "user.email=pi-lane@local",
                    "commit", "-m", f"Lane {name}: {summary}",
                )
                print(f"{name}: committed its work on {branch}")

        default = _default_branch(repo) if repo and Path(repo).is_dir() else ""
        merged_sha = ""
        merged_subject = ""
        merged_date = ""
        reason = args.reason
        if default and not args.no_merge:
            rc, _, _ = _git(repo, "rev-parse", "--verify", "--quiet", branch)
            if rc == 0:
                rc_merged, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, default)
                if rc_merged != 0:
                    rc_m, out_m, err_m = _git(repo, "merge", "--no-ff", branch, "-m", f"Merge lane {name}")
                    if rc_m != 0:
                        print(f"{name}: merge failed — {err_m or out_m}", file=sys.stderr)
                        failed += 1
                        continue
                rc_s, sha, _ = _git(repo, "rev-parse", default)
                if rc_s == 0:
                    merged_sha = sha
                    _, subject, _ = _git(repo, "log", "-1", "--format=%s", sha)
                    merged_subject = subject
                    _, date, _ = _git(repo, "log", "-1", "--format=%ad", "--date=short", sha)
                    merged_date = date
                reason = reason or f"closed after merge into {default}"
        if not reason:
            reason = "closed by hand"

        record["closed_at"] = int(time.time())
        record["closed_reason"] = reason
        if merged_sha:
            files, added, removed = _shortstat(repo, merged_sha)
            record.update({
                "merge_sha": merged_sha,
                "merge_subject": merged_subject,
                "closed_date": merged_date,
                "merge_files": files,
                "merge_insertions": added,
                "merge_deletions": removed,
            })
        lane_dir.mkdir(parents=True, exist_ok=True)
        (lane_dir / "lane.json").write_text(json.dumps(record, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        # One line for the journal, so closed lanes stay visible after their folder is gone.
        receipt = {
            "lane": name,
            "project": record.get("project"),
            "group": record.get("group"),
            "branch": branch,
            "state": state or "done",
            "closed_at": record["closed_at"],
            "closed_reason": reason,
            "merge_sha": merged_sha,
            "merge_subject": merged_subject,
            "closed_date": merged_date,
            "merge_files": record.get("merge_files", 0),
            "merge_insertions": record.get("merge_insertions", 0),
            "merge_deletions": record.get("merge_deletions", 0),
            "base": default,
        }
        (root / "closed.jsonl").open("a", encoding="utf-8").write(
            json.dumps(receipt, ensure_ascii=False) + "\n"
        )

        cleaned = []
        if not args.keep:
            if worktree.is_dir():
                rc_w, _, err_w = _git(repo, "worktree", "remove", "--force", str(worktree))
                cleaned.append("worktree" if rc_w == 0 else f"worktree kept ({err_w})")
            if branch and repo:
                rc_b, _, _ = _git(repo, "branch", "-d", branch)
                if rc_b != 0:
                    _git(repo, "branch", "-D", branch)
                cleaned.append("branch")
            for leftover in (lane_dir / "events.jsonl", lane_dir / "stderr.txt", lane_dir / "thread.jsonl",
                             lane_dir / "lane.json", lane_dir / "question.json", lane_dir / "answer.json"):
                leftover.unlink(missing_ok=True)
            try:
                lane_dir.rmdir()
                cleaned.append("lane folder")
            except OSError:
                pass
            # pi keeps its own history beside the worktree: without this the folder outlives
            # the lane and turns into a 90K orphan per lane.
            session_files = pi_session_files(worktree, str(record.get("session_id") or ""))
            for item in session_files:
                item.unlink(missing_ok=True)
            folder = pi_session_dir(worktree)
            if session_files and folder.is_dir():
                try:
                    folder.rmdir()
                except OSError:
                    pass
            if session_files:
                cleaned.append("pi session")

        extra = f" · merged {merged_sha[:7]} into {default}" if merged_sha else ""
        tail = f" · removed {', '.join(cleaned)}" if cleaned else ""
        print(f"{name}: closed{extra}{tail}")

    return 1 if failed else 0


def check_lane(argv: list) -> int:
    """Record that the orchestrator read this lane's work: `checked_at` and the worktree's HEAD.

    The panel shows a lane as `reviewed` — and offers its CLOSE control — only while that sha is still the
    worktree's HEAD, so a check can never stand for work that landed after it.
    """
    parser = argparse.ArgumentParser(prog="pi-lane check")
    parser.add_argument("lane")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    worktree = str(record.get("worktree") or "")
    if not worktree or not Path(worktree).is_dir():
        print(f"{args.lane}: no worktree to check", file=sys.stderr)
        return 1
    rc, sha, err = _git(worktree, "rev-parse", "HEAD")
    if rc != 0:
        print(f"{args.lane}: git says: {err}", file=sys.stderr)
        return 1
    record["checked_at"] = int(time.time())
    record["checked_sha"] = sha
    write_record(lane_dir, record)
    print(f"{args.lane}: checked at {sha[:7]}")
    return 0


def say_in_thread(argv: list) -> int:
    """Append an orchestrator reply into a lane's thread. Nothing is sent to pi."""
    parser = argparse.ArgumentParser(prog="pi-lane say")
    parser.add_argument("lane")
    parser.add_argument("text")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    if not (lane_dir / "lane.json").exists():
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    entry = {"who": "jarvis", "at": int(time.time()), "text": args.text}
    with (lane_dir / "thread.jsonl").open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
    print(f"{args.lane}: said")
    return 0


def hand_lane(argv: list) -> int:
    """File a finished lane for review: `handed_at`, the field the panel reads as TO REVIEW.

    Same field the panel's route writes, so an orchestrator in a chat session reaches the review
    shelf without the desktop being open.
    """
    parser = argparse.ArgumentParser(prog="pi-lane hand")
    parser.add_argument("lane")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    if record.get("closed_at"):
        print(f"{args.lane}: already closed", file=sys.stderr)
        return 1
    if record.get("state") in ("running", "waiting"):
        print(f"{args.lane}: still {record.get('state')} — a lane is filed when it has finished", file=sys.stderr)
        return 1
    record["handed_at"] = int(time.time())
    write_record(lane_dir, record)
    files, added, removed = _shortstat(str(record.get("repo") or ""), str(record.get("branch") or ""))
    print(f"{args.lane}: in review — {files} files +{added} -{removed}")
    return 0


def answer_lane(argv: list) -> int:
    """Answer the question a waiting lane parked in `question.json`, from any host."""
    parser = argparse.ArgumentParser(prog="pi-lane answer")
    parser.add_argument("lane")
    parser.add_argument("value")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    if not (lane_dir / "lane.json").exists():
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    question = read_json(lane_dir / "question.json")
    payload: dict = {"value": args.value}
    if isinstance(question, dict) and question.get("id"):
        payload["id"] = question["id"]
    tmp = lane_dir / "answer.json.tmp"
    tmp.write_text(json.dumps(payload, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(tmp, lane_dir / "answer.json")
    print(f"{args.lane}: answered")
    return 0


def list_lanes(argv: list) -> int:
    """Print lanes with the state the panel shows, so an agent can pick one without the UI."""
    rows = []
    for record in lane_records():
        rows.append(record)
    rows.sort(key=lambda r: r.get("started") or 0, reverse=True)
    if not rows:
        print("no lanes")
        return 0
    for r in rows:
        if r.get("closed_at"):
            shelf = "closed"
        elif r.get("handed_at"):
            shelf = "review"
        else:
            shelf = str(r.get("state") or "?")
        print(f"{r.get('lane')}\t{shelf}\t{r.get('project') or '-'}\t{(r.get('task') or '')[:60]}")
    return 0


def _lane_state(lane: str) -> tuple[str, dict | None, dict | None]:
    lane_dir = hermes_home() / "lanes" / lane
    record = read_json(lane_dir / "lane.json")
    question = read_json(lane_dir / "question.json") if record and record.get("state") == "waiting" else None
    return (str(record.get("state") or "") if record else "gone"), record, question


def _report_lane(lane: str, state: str, record: dict | None, question: dict | None,
                 files: int, added: int, removed: int, as_json: bool) -> None:
    if as_json:
        print(json.dumps({
            "lane": lane, "state": state, "files": files, "insertions": added,
            "deletions": removed, "closed": bool((record or {}).get("closed_at")),
            "question": ({"id": question.get("id"), "title": question.get("title") or question.get("message") or ""}
                         if isinstance(question, dict) else None),
        }, ensure_ascii=False))
    elif question is not None:
        print(f"{lane}: waiting — {question.get('title') or question.get('message') or ''}")
    elif state == "done":
        print(f"{lane}: done — {files} files +{added} -{removed}")
    else:
        print(f"{lane}: {state}")


def wait_all(argv: list) -> int:
    """Wait for several lanes at once.

    `pi-lane wait --all` follows every lane that is running or waiting; names may narrow it.
    Returns 3 as soon as ANY lane is waiting on a question, because that one needs a person
    before the others can be merged. This is the verb that makes parallel lanes affordable:
    start three, wait on all three, merge in dependency order.
    """
    parser = argparse.ArgumentParser(prog="pi-lane wait --all")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("lanes", nargs="*")
    parser.add_argument("--timeout", type=int, default=3600, help="seconds; 0 waits forever")
    parser.add_argument("--interval", type=float, default=3.0)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    watch = list(args.lanes)
    if not watch:
        for record in lane_records():
            if str(record.get("state") or "") in ("running", "waiting"):
                watch.append(str(record.get("lane")))
    if not watch:
        if args.json:
            print(json.dumps({"lanes": [], "state": "empty"}))
        else:
            print("no lanes to wait for")
        return 0

    deadline = (time.monotonic() + args.timeout) if args.timeout else None
    printed: dict[str, str] = {}
    while True:
        states: dict[str, str] = {}
        waiting: list[str] = []
        failed = False
        for lane in watch:
            state, record, question = _lane_state(lane)
            states[lane] = state
            if question is not None:
                waiting.append(lane)
            if state in ("failed", "error"):
                failed = True
            if printed.get(lane) != state or question is not None:
                files = added = removed = 0
                if record and record.get("repo") and record.get("branch"):
                    try:
                        files, added, removed = _shortstat(str(record["repo"]), str(record["branch"]))
                    except Exception:
                        pass
                _report_lane(lane, state, record, question, files, added, removed, args.json)
                printed[lane] = state
        if waiting:
            return 3
        if all(s in ("done", "failed", "stopped", "cancelled", "error", "gone") for s in states.values()):
            if not args.json:
                done = sum(1 for s in states.values() if s == "done")
                print(f"all settled — {done}/{len(watch)} done")
            return 1 if failed else 0
        if deadline is not None and time.monotonic() > deadline:
            pending = ", ".join(f"{k}={v}" for k, v in states.items() if v in ("running", "waiting"))
            print(f"timeout after {args.timeout}s — still: {pending}", file=sys.stderr)
            return 124
        time.sleep(args.interval)


def wait_lane(argv: list) -> int:
    """Block until a lane stops moving on its own: done, failed, or waiting on a question.

    This is what an orchestrator needs instead of `sleep 180` in a loop. Exit codes are the
    contract: 0 terminal state, 3 the lane is waiting for an answer, 124 timeout.
    """
    parser = argparse.ArgumentParser(prog="pi-lane wait")
    parser.add_argument("lane")
    parser.add_argument("--timeout", type=int, default=3600, help="seconds; 0 waits forever")
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    deadline = (time.monotonic() + args.timeout) if args.timeout else None
    seen_printed = ""
    while True:
        record = read_json(lane_dir / "lane.json")
        if record is None:
            if args.json:
                print(json.dumps({"lane": args.lane, "state": "gone"}))
            else:
                print(f"no such lane: {args.lane}", file=sys.stderr)
            return 1
        state = str(record.get("state") or "")
        files = added = removed = 0
        repo = str(record.get("repo") or "")
        branch = str(record.get("branch") or "")
        if repo and branch:
            try:
                files, added, removed = _shortstat(repo, branch)
            except Exception:
                pass
        question = None
        if state == "waiting":
            q = read_json(lane_dir / "question.json")
            if isinstance(q, dict):
                question = {"id": q.get("id"), "title": q.get("title") or q.get("message") or ""}
        if args.json:
            payload = {"lane": args.lane, "state": state, "files": files,
                       "insertions": added, "deletions": removed,
                       "closed": bool(record.get("closed_at")), "question": question}
            print(json.dumps(payload, ensure_ascii=False))
        elif state != seen_printed:
            # One line per state change: a poll loop that repeats itself is noise in an agent's context.
            seen_printed = state
            if question is not None:
                print(f"{args.lane}: waiting — {question['title']}")
            elif state == "done":
                print(f"{args.lane}: done — {files} files +{added} -{removed}")
            else:
                print(f"{args.lane}: {state}")
        if question is not None:
            return 3
        if state in ("done", "failed", "stopped", "cancelled", "error") or record.get("closed_at"):
            return 0 if state == "done" or record.get("closed_at") else 1
        if deadline is not None and time.monotonic() > deadline:
            print(f"{args.lane}: timeout after {args.timeout}s in state {state}", file=sys.stderr)
            return 124
        time.sleep(args.interval)


def gate_lanes(argv: list) -> int:
    """Run the project gates in the MERGED tree and record the check on each lane.

    Two refusals make this verb worth having. A lane whose branch is not yet an ancestor of HEAD
    was never merged, so a green run here would bless work that is not in the tree. And lanes from
    different repositories cannot share one gate run, because one command set would answer for both.
    On success it writes `checked_at` and `checked_sha` — the same pair the panel reads to offer
    CLOSE.
    """
    parser = argparse.ArgumentParser(prog="pi-lane gate")
    parser.add_argument("lanes", nargs="+")
    parser.add_argument("--cmd", action="append", default=[], help="a gate command; repeatable")
    parser.add_argument("--cwd", default="", help="run here instead of the repository root")
    parser.add_argument("--timeout", type=int, default=1800, help="seconds per command")
    args = parser.parse_args(argv)
    if not args.cmd:
        print("pi-lane gate: pass at least one --cmd \"<command>\"", file=sys.stderr)
        return 2

    records = {}
    repos = set()
    for lane in args.lanes:
        record = read_json(hermes_home() / "lanes" / lane / "lane.json")
        if record is None:
            print(f"{lane}: no such lane", file=sys.stderr)
            return 1
        if record.get("closed_at"):
            print(f"{lane}: already closed", file=sys.stderr)
            return 1
        repo = str(record.get("repo") or "")
        if not repo:
            print(f"{lane}: the record carries no repository", file=sys.stderr)
            return 1
        records[lane] = record
        repos.add(os.path.realpath(repo))
    if len(repos) != 1:
        print(f"lanes span {len(repos)} repositories: {', '.join(sorted(repos))}", file=sys.stderr)
        return 1
    repo = repos.pop()
    workdir = os.path.realpath(args.cwd) if args.cwd else repo

    rc, head, err = _git(repo, "rev-parse", "HEAD")
    if rc != 0:
        print(f"{repo}: git says: {err}", file=sys.stderr)
        return 1

    # The whole point: a gate that runs next to unmerged work proves nothing about the tree.
    unmerged = []
    for lane, record in records.items():
        branch = str(record.get("branch") or "")
        if not branch:
            continue
        rc, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, "HEAD")
        if rc != 0:
            unmerged.append(lane)
    if unmerged:
        print(f"refusing: not merged into HEAD ({head[:7]}): {', '.join(sorted(unmerged))}", file=sys.stderr)
        print("merge them first — a gate here would bless work that is not in the tree", file=sys.stderr)
        return 1

    started = time.time()
    for command in args.cmd:
        print(f"$ {command}   (in {workdir})")
        try:
            done = subprocess.run(command, shell=True, cwd=workdir, capture_output=True, text=True,
                                  timeout=args.timeout)
        except subprocess.TimeoutExpired:
            print(f"timeout after {args.timeout}s: {command}", file=sys.stderr)
            return 1
        output = ((done.stdout or "") + (done.stderr or "")).strip()
        tail = "\n".join(output.splitlines()[-12:])
        if tail:
            print(tail)
        print(f"-> exit {done.returncode}")
        if done.returncode != 0:
            print(f"gate failed, nothing recorded: {command}", file=sys.stderr)
            return 1

    for lane, record in records.items():
        record["checked_at"] = int(time.time())
        record["checked_sha"] = head
        record["gate_cmds"] = list(args.cmd)
        record["gate_seconds"] = int(time.time() - started)
        write_record(hermes_home() / "lanes" / lane, record)
    print(f"gate ok — checked {len(records)} lane(s) at {head[:7]}")
    return 0


def review_queue(argv: list) -> int:
    """Print the review shelf: the lanes a person filed, with everything a check needs.

    This is the pull half of the panel's `SEND`: nothing is injected into a chat, the orchestrator
    asks for the queue when it wants to work. Same fields the injected message carried.
    """
    parser = argparse.ArgumentParser(prog="pi-lane review")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    rows = [r for r in lane_records() if r.get("handed_at") and not r.get("closed_at")]
    rows.sort(key=lambda r: r.get("handed_at") or 0)
    if args.json:
        print(json.dumps([{k: r.get(k) for k in ("lane", "project", "group", "state", "task",
                                                 "files", "insertions", "deletions", "worktree")}
                          for r in rows], ensure_ascii=False))
        return 0
    if not rows:
        print("review queue: empty")
        return 0
    print(f"Review queue: {len(rows)} lane(s).")
    for r in rows:
        print(f"- {r.get('project') or '?'}/{r.get('group') or '-'}/{r.get('lane')} — {r.get('state')}"
              f" — {r.get('files', 0)} files +{r.get('insertions', 0)} -{r.get('deletions', 0)}")
        if r.get("task"):
            # The record's `task` is the full brief a lane was given; print its point, not its length.
            head = " ".join(str(r["task"]).split())[:140]
            print(f"  task: {head}")
        texts = assistant_texts(hermes_home() / "lanes" / str(r.get("lane")))
        if texts:
            print(f"  says: {' '.join(texts[-1].split())[:240]}")
        if r.get("worktree"):
            print(f"  look: {r['worktree']} · pi-lane check {r.get('lane')}")
    print("\nCheck each one, report what you found, and wait for his go before closing.")
    return 0


def digest_lane(argv: list) -> int:
    """Print one lane as a compact record: task, commits, diff size, gate result, leftovers.

    The point is to make a later 'write a skill from this' cost one call instead of a re-read of
    the repository.
    """
    parser = argparse.ArgumentParser(prog="pi-lane digest")
    parser.add_argument("lane")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    repo = str(record.get("repo") or "")
    branch = str(record.get("branch") or "")
    print(f"lane      {record.get('lane')}  ({record.get('state')})")
    print(f"project   {record.get('project') or '-'} / {record.get('group') or '-'}")
    print(f"task      {' '.join(str(record.get('task') or '').split())[:300]}")
    print(f"model     {record.get('provider') or '?'} / {record.get('model') or '?'}")
    if record.get("handed_at"):
        print(f"handed    yes")
    if record.get("checked_at"):
        print(f"checked   {str(record.get('checked_sha'))[:7]} · {'; '.join(record.get('gate_cmds') or [])}")
    if record.get("last_error"):
        print(f"error     {str(record.get('last_error'))[:200]}")
    if repo and branch:
        rc, log, _ = _git(repo, "log", "--oneline", f"-8", branch)
        if rc == 0 and log:
            print("commits   " + "\n          ".join(log.splitlines()))
        rc, base, _ = _git(repo, "merge-base", branch, "HEAD")
        if rc == 0:
            rc2, stat, _ = _git(repo, "diff", "--stat", f"{base[:12]}..{branch}")
            if rc2 == 0 and stat:
                print("diff      " + "\n          ".join(stat.splitlines()[-4:]))
    texts = assistant_texts(lane_dir)
    if texts:
        print(f"says      {' '.join(texts[-1].split())[:300]}")
    return 0


def run_session(lane_dir: Path, record: dict, lane: str, worktree: Path, task: str, question_timeout: int) -> int:
    """One `pi --mode rpc` turn: the lane's first task or a continuation of its session."""
    events_path = lane_dir / "events.jsonl"
    stderr_path = lane_dir / "stderr.txt"
    question_path = lane_dir / "question.json"
    answer_path = lane_dir / "answer.json"
    text = ""
    cmd = [
        "pi", "--mode", "rpc", "--session-id", record["session_id"],
        "--provider", record["provider"], "--model", record["model"], "--thinking", record.get("thinking") or DEFAULT_THINKING,
    ]
    text = ""
    exit_code = 0
    finished = False

    with stderr_path.open("a", encoding="utf-8") as stderr_handle, events_path.open(
        "a", encoding="utf-8"
    ) as events:
        proc = subprocess.Popen(
            cmd, cwd=str(worktree), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=stderr_handle, text=True, bufsize=1,
        )
        assert proc.stdin is not None and proc.stdout is not None
        proc.stdin.write(json.dumps({"type": "prompt", "message": task}) + "\n")
        proc.stdin.flush()

        question: dict | None = None
        question_since = 0.0

        while True:
            ready, _, _ = select.select([proc.stdout], [], [], POLL_SECONDS)

            if ready:
                line = proc.stdout.readline()
                if not line:
                    break
                if _keep_event(line):
                    events.write(line)
                    events.flush()
                try:
                    event = json.loads(line)
                except ValueError:
                    continue

                kind = event.get("type")
                if kind == "message_end":
                    said = assistant_text(event)
                    if said:
                        text = said
                elif kind == "extension_ui_request" and event.get("method") in DIALOG_METHODS:
                    question = {
                        "id": event.get("id"),
                        "method": event.get("method"),
                        "title": event.get("title") or "",
                        "message": event.get("message") or "",
                        "options": event.get("options") or [],
                        "asked_at": int(time.time()),
                    }
                    question_since = time.monotonic()
                    question_path.write_text(json.dumps(question, indent=2) + "\n", encoding="utf-8")
                    record["state"] = "waiting"
                    write_record(lane_dir, record)
                elif kind == "agent_end":
                    finished = True

            if question is not None:
                if answer_path.exists():
                    try:
                        answer = json.loads(answer_path.read_text(encoding="utf-8"))
                    except (OSError, ValueError):
                        answer = {}
                    if answer.get("id") in (None, question["id"]):
                        payload: dict = {"type": "extension_ui_response", "id": question["id"]}
                        if answer.get("cancelled"):
                            payload["cancelled"] = True
                        else:
                            payload["value"] = str(answer.get("value", ""))
                        proc.stdin.write(json.dumps(payload) + "\n")
                        proc.stdin.flush()
                        question = None
                        question_path.unlink(missing_ok=True)
                        answer_path.unlink(missing_ok=True)
                        record["state"] = "running"
                        write_record(lane_dir, record)
                elif question_timeout and (time.monotonic() - question_since) > question_timeout:
                    proc.stdin.write(json.dumps({
                        "type": "extension_ui_response", "id": question["id"], "cancelled": True,
                    }) + "\n")
                    proc.stdin.flush()
                    question_path.unlink(missing_ok=True)
                    question = None
                    record["state"] = "running"
                    write_record(lane_dir, record)

            if finished or proc.poll() is not None:
                break

        # pi in RPC mode is a server: it stays alive after `agent_end`. Drain
        # whatever is already in the pipe, then stop it ourselves.
        while True:
            ready, _, _ = select.select([proc.stdout], [], [], 0.2)
            if not ready:
                break
            line = proc.stdout.readline()
            if not line:
                break
            if _keep_event(line):
                events.write(line)

        try:
            proc.stdin.close()
        except OSError:
            pass
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=10)

        exit_code = int(proc.returncode or 0)

    record["finished"] = int(time.time())
    record["exit"] = exit_code
    record["state"] = "done" if (exit_code == 0 and text) else "failed"
    write_record(lane_dir, record)
    question_path.unlink(missing_ok=True)
    return exit_code


def continue_lane(argv: list) -> int:
    """Add a task to a finished lane by running its own session again."""
    parser = argparse.ArgumentParser(prog="pi-lane continue")
    parser.add_argument("lane")
    parser.add_argument("text")
    parser.add_argument("--question-timeout", type=int, default=1800)
    args = parser.parse_args(argv)

    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if not record:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    if record.get("closed_at"):
        print(f"{args.lane}: closed — open a new lane instead", file=sys.stderr)
        return 1
    if str(record.get("state")) == "running" and pid_alive(record.get("pid")):
        print(f"{args.lane}: still running", file=sys.stderr)
        return 1
    worktree = Path(str(record.get("worktree") or ""))
    if not worktree.is_dir():
        print(f"{args.lane}: its worktree is gone", file=sys.stderr)
        return 1

    with (lane_dir / "thread.jsonl").open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({"who": "user", "at": int(time.time()), "text": args.text}, ensure_ascii=False) + "\n")

    record.pop("closed_at", None)
    record.pop("closed_reason", None)
    record["handed_at"] = None
    record["state"] = "running"
    record["pid"] = os.getpid()
    record["started"] = int(time.time())
    record["exit"] = None
    record["finished"] = None
    write_record(lane_dir, record)
    load_env_keys()
    print(f"{args.lane}: continuing")
    return run_session(lane_dir, record, args.lane, worktree, args.text, args.question_timeout)


def main() -> int:
    if len(sys.argv) > 2 and sys.argv[1] == "wait" and "--all" in sys.argv[2:]:
        return wait_all(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "review":
        return review_queue(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "digest":
        return digest_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "gate":
        return gate_lanes(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "wait":
        return wait_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "hand":
        return hand_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "answer":
        return answer_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "list":
        return list_lanes(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "close":
        return close_lanes(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "check":
        return check_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "say":
        return say_in_thread(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "continue":
        return continue_lane(sys.argv[2:])

    parser = argparse.ArgumentParser(
        prog="pi-lane",
        epilog=(
            "verbs with the lane lifecycle: pi-lane wait <lane> [--timeout S] [--json] (block until it finishes or asks), "
            "pi-lane wait --all [lane …] (block on several at once, 3 if any asks), "
            "pi-lane gate <lane …> --cmd \"…\" (run the gates in the MERGED tree and record the check), "
            "pi-lane review (print the review shelf instead of injecting it), pi-lane digest <lane> (a compact record), "
            "pi-lane hand <lane> (file for review), "
            "pi-lane check <lane> (record that its work was read), "
            "pi-lane close <lane> [--no-merge] [--yes], "
            "pi-lane say <lane> \"text\", pi-lane answer <lane> \"value\", pi-lane list"
        ),
    )
    parser.add_argument("lane")
    parser.add_argument("task")
    parser.add_argument("--repo", default="", help="repository path; resolved from the registry when omitted")
    parser.add_argument("--project", default="", help="registered project name")
    parser.add_argument("--feature", "--group", dest="feature", default="", help="feature name inside the project")
    parser.add_argument("--provider", default=DEFAULT_PROVIDER)
    parser.add_argument("--model", default=DEFAULT_MODEL)
    parser.add_argument("--thinking", default=DEFAULT_THINKING)
    parser.add_argument("--question-timeout", type=int, default=1800)
    args = parser.parse_args()

    if not LANE_RE.match(args.lane):
        fail(f"bad lane name: {args.lane}")

    project = args.project
    repo_path = args.repo
    if project:
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        import pireg  # noqa: E402

        entry = pireg.project(pireg.load(), project)
        if entry is None:
            fail(f"unknown project: {project} — register it with pi-project add")
        repo_path = str(entry.get("repo") or "")
        if not repo_path:
            fail(f"project {project} has no repo path")
    if not repo_path:
        fail("pass --project or --repo")
    repo = os.path.realpath(repo_path)
    if not Path(repo, ".git").exists():
        fail(f"not a git repo: {repo}")
    project = project or Path(repo).name
    if not any(
        os.access(os.path.join(folder, "pi"), os.X_OK)
        for folder in os.environ.get("PATH", "").split(os.pathsep)
        if folder
    ):
        fail("pi not found")

    load_env_keys()

    lane = args.lane
    worktree = Path(repo) / ".worktrees" / lane
    branch = f"lane/{lane}"

    # Guards: one running lane per name in a repository, and a warning when the
    # same feature already has a lane in flight. No lock files: the record and
    # its pid are the truth.
    in_flight: list = []
    for record in lane_records():
        running = str(record.get("state")) == "running" and pid_alive(record.get("pid"))
        if not running:
            continue
        if record.get("lane") == lane and record.get("repo") == repo:
            fail(f"lane {lane} is already running in {repo}")
        if record.get("repo") == repo and args.feature and record.get("group") == args.feature.strip():
            in_flight.append(str(record.get("lane")))
    if in_flight:
        print(
            f"pi-lane: note — feature {args.feature} already has a lane in flight: {', '.join(in_flight)}",
            file=sys.stderr,
        )
    lane_dir = hermes_home() / "lanes" / lane
    lane_dir.mkdir(parents=True, exist_ok=True)
    events_path = lane_dir / "events.jsonl"
    stderr_path = lane_dir / "stderr.txt"
    question_path = lane_dir / "question.json"
    answer_path = lane_dir / "answer.json"
    for stale in (question_path, answer_path):
        if stale.exists():
            stale.unlink()
    events_path.write_text("", encoding="utf-8")

    if not worktree.is_dir():
        created = False
        for extra in (["-b", branch], []):
            done = subprocess.run(
                ["git", "-C", repo, "worktree", "add", "-q", str(worktree), *extra],
                capture_output=True, text=True, check=False,
            )
            if done.returncode == 0:
                created = True
                break
        if not created:
            fail(f"git worktree add failed for {worktree}")
    ensure_excludes(repo)

    record = {
        "lane": lane,
        "task": args.task,
        "project": project,
        "group": args.feature.strip(),
        "repo": repo,
        "worktree": str(worktree),
        "branch": branch,
        "session_id": f"{Path(repo).name}-{lane}",
        "provider": args.provider,
        "model": args.model,
        "thinking": args.thinking,
        "state": "running",
        "pid": os.getpid(),
        "started": int(time.time()),
        "exit": None,
    }
    write_record(lane_dir, record)
    return run_session(lane_dir, record, lane, worktree, args.task, args.question_timeout)



if __name__ == "__main__":
    raise SystemExit(main())
