#!/usr/bin/env python3
"""pi-lane — run one headless pi lane, answer its questions, record what it says.

    pi-lane <lane> <repo> "<task>" [--provider P] [--model M] [--thinking L]
            [--question-timeout SECONDS]

A lane is a worktree plus one `pi --mode rpc` run:

    <repo>/.worktrees/<lane>                  branch lane/<lane>
    $HERMES_HOME/lanes/<lane>/lane.json       record: task, state, pid, session
    $HERMES_HOME/lanes/<lane>/events.jsonl    raw pi event stream
    $HERMES_HOME/lanes/<lane>/question.json   the question pi waits on
    $HERMES_HOME/lanes/<lane>/answer.json     the answer, written by the panel
    $HERMES_HOME/lanes/<lane>/stderr.txt      stderr

RPC mode is what makes questions work: an extension dialog arrives as an
`extension_ui_request`, the runner parks it in question.json, and the panel
writes answer.json. No tmux, no pty.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path
from typing import NoReturn

DIALOG_METHODS = {"select", "confirm", "input", "editor"}
# A confirmation that names one of these is refused without a person, even in autonomous mode.
DESTRUCTIVE_WORDS = (
    "rm -rf", "rm ", "delete", "drop table", "drop ", "force", "--hard", "push",
    "truncate", "credential", "secret", "token", "password", "chmod 777", "sudo ",
)
POLL_SECONDS = 0.3
ENV_KEYS = (
    "NVIDIA_API_KEY",
    "DEEPSEEK_API_KEY",
    "OPENROUTER_API_KEY",
    "OPENCODE_API_KEY",
    "OPENCODE_GO_API_KEY",
    "ANTHROPIC_API_KEY",
)
# pi names the opencode credential OPENCODE_API_KEY; Hermes stores the same value as
# OPENCODE_GO_API_KEY. Hand pi the name it reads, or the provider looks unconfigured.
ALIASES = {"OPENCODE_GO_API_KEY": "OPENCODE_API_KEY"}
DEFAULT_PROVIDER = "nvidia"
DEFAULT_MODEL = "nvidia/nemotron-3.5-super-vl-120b-a12b"
DEFAULT_THINKING = "medium"
# The critic reads what the lane wrote and reports only what breaks. A different vendor on purpose:
# a reviewer on the author's own model shares its blind spots.
DEFAULT_REVIEW_PROVIDER = os.environ.get("PI_TEAM_REVIEW_PROVIDER") or "opencode-go"
DEFAULT_REVIEW_MODEL = os.environ.get("PI_TEAM_REVIEW_MODEL") or "glm-5.3-flash"
# `auto`: the lane answers its own dialogs and never parks for a person. `ask`: a dialog parks the lane
# in `waiting` until an answer lands. Safe by construction, because `auto` refuses a destructive
# confirmation and the critic and the gate still stand between the work and the main branch.
DEFAULT_AUTONOMY = os.environ.get("PI_TEAM_AUTONOMY") or "auto"
REVIEW_TIMEOUT = 300
REVIEW_MARKER = "REVIEW:"
REVIEW_PROMPT = """You review one slice of a coding task. You cannot change anything: judge what you read.

BRIEF THE LANE WAS GIVEN:
{brief}

FILES THE LANE DECLARED:
{touches}

WHAT THE LANE CLAIMS (its RESULT line):
{result}

GIT STATUS IN THE LANE'S WORKTREE:
{status}

DIFF AGAINST THE BRANCH IT WAS CUT FROM:
{diff}

Report only defects that matter:
P0 — the diff does not do what the brief says, a documented path is broken, work or data is lost,
     a test it claims green cannot pass, a secret is written, or a file it was told not to touch is edited.
P1 — the RESULT claims what the diff does not show, or a declared file is missing or empty.
Never report style, naming, formatting or taste. Empty lists mean the work is clean.

Answer with one line as the last line of your answer:
REVIEW: {{"p0": ["..."], "p1": ["..."], "notes": ["..."]}}
"""
# A lane that loops on a failing test must not run all night: the idle cap catches the stuck case
# without a word from anybody, and the money and turn caps are opt-in because a big slice is allowed.
DEFAULT_MAX_USD = 0.0
DEFAULT_MAX_TURNS = 0
DEFAULT_IDLE_TIMEOUT = 1800
LANE_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def hermes_home() -> Path:
    return Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")


def fail(message: str) -> NoReturn:
    print(f"pi-lane: {message}", file=sys.stderr)
    raise SystemExit(2)


def apply_aliases() -> None:
    """Hermes names a credential differently from pi; hand pi the name it reads.

    Both env branches end here: a spawn that already carries the Hermes name returns early,
    and without this pass ``opencode-go`` stays unconfigured while the key sits in the env.
    """
    for source, target in ALIASES.items():
        value = (os.environ.get(source) or "").strip()
        if value and not (os.environ.get(target) or "").strip():
            os.environ[target] = value


def load_env_keys() -> None:
    """Put the provider keys into this process, for the pi run it starts.

    Hermes's own secret scope comes first: run the runner with Hermes's interpreter and the keys
    arrive profile-scoped, exactly as Hermes reads them. A plain `python3` has no such scope, so the
    fallback parses the profile's `.env` — the one file the keys live in when no scope is installed.
    """
    try:
        from agent.secret_scope import get_secret

        for name in ENV_KEYS:
            value = (get_secret(name) or "").strip()
            if value and not os.environ.get(name):
                os.environ[name] = value
    except Exception:
        pass
    # No early return here. A scope that answers for one provider says nothing about another, and a
    # single unrelated key in the environment — the gateway's own, say — used to stop this fallback
    # before it read the file. The file is the last place a key can come from: read it always.
    env_file = hermes_home() / ".env"
    if not env_file.is_file():
        return
    try:
        lines = env_file.read_text(errors="replace").splitlines()
    except OSError:
        return
    for line in lines:
        name, sep, value = line.partition("=")
        name = name.strip()
        if not sep or name not in ENV_KEYS:
            continue
        value = value.strip()
        target = ALIASES.get(name, name)
        if not os.environ.get(target):
            os.environ[target] = value
    apply_aliases()


def write_record(lane_dir: Path, record: dict) -> None:
    tmp = lane_dir / "lane.json.tmp"
    tmp.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    tmp.replace(lane_dir / "lane.json")


def ensure_excludes(repo: str) -> None:
    """Hide lane scratch from the main checkout without touching tracked files."""
    base = Path(repo) / ".git"
    try:
        done = subprocess.run(
            ["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=10, check=False,
        )
        if done.returncode == 0 and done.stdout.strip():
            base = Path(done.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        pass
    info = base / "info"
    info.mkdir(parents=True, exist_ok=True)
    exclude = info / "exclude"
    existing = exclude.read_text(errors="replace").splitlines() if exclude.is_file() else []
    for pattern in ("/.worktrees/", ".thinkrail/"):
        if pattern not in existing:
            with exclude.open("a", encoding="utf-8") as handle:
                handle.write(pattern + "\n")


def pid_alive(pid) -> bool:
    try:
        value = int(pid)
    except (TypeError, ValueError):
        return False
    if value <= 0:
        return False
    try:
        os.kill(value, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, owned by another user
    except OSError:
        return False
    return True


def lane_records() -> list:
    """Every readable lane record, so guards can see what is already running."""
    records = []
    root = hermes_home() / "lanes"
    if not root.is_dir():
        return records
    for path in sorted(root.glob("*/lane.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8", errors="replace"))
        except (OSError, ValueError):
            continue
        if isinstance(record, dict):
            records.append(record)
    return records


# Streaming deltas are 51-68% of the stream and nothing reads them: the runner drives its state from
# message_end, tool_execution_* and the question events, the backend reads the same, and the panel
# shows the last finished message. Keep the delta out of the file unless somebody asks for it.
_DROP_EVENT_TYPES = () if os.environ.get("PI_LANE_KEEP_DELTAS") else ("message_update",)


def _keep_event(line: str) -> bool:
    """True when this raw line belongs in events.jsonl."""
    if not _DROP_EVENT_TYPES:
        return True
    stripped = line.lstrip()
    if not stripped.startswith("{"):
        return True
    for name in _DROP_EVENT_TYPES:
        if f'"type":"{name}"' in stripped or f'"type": "{name}"' in stripped:
            return False
    return True


def assistant_text(event: dict) -> str:
    message = event.get("message") or {}
    if message.get("role") != "assistant":
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return content.strip()
    if not isinstance(content, list):
        return ""
    parts = [p.get("text", "") for p in content if isinstance(p, dict) and p.get("type") == "text"]
    return "\n".join(p for p in parts if p).strip()


RESULT_MARKER = "RESULT:"


def _json_after(text: str, marker: str):
    """The first JSON object that follows the last `marker` in a text, or None."""
    if not text:
        return None
    index = text.upper().rfind(marker)
    if index < 0:
        return None
    tail = text[index + len(marker):].strip().strip("`").strip()
    start = tail.find("{")
    if start < 0:
        return None
    depth = 0
    for position, char in enumerate(tail[start:], start=start):
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                try:
                    return json.loads(tail[start:position + 1])
                except ValueError:
                    return None
    return None


def parse_result(text: str) -> tuple:
    """Read the lane's machine-readable report: the last `RESULT: {...}` in its final text.

    Returns `(result, status)` with status `ok`, `missing` or `invalid`. The prose stays for a person;
    this object is what an orchestrator reads without paying for the whole report again.
    """
    if RESULT_MARKER not in text.upper():
        return None, "missing"
    result = _json_after(text, RESULT_MARKER)
    if not isinstance(result, dict):
        return None, "invalid"
    files = result.get("files")
    if not isinstance(files, list) or not all(isinstance(item, str) for item in files):
        return None, "invalid"
    for key in ("risks", "followups"):
        if key in result and not isinstance(result[key], list):
            return None, "invalid"
    verify = result.get("verify")
    if verify is not None and not (isinstance(verify, dict) and "exit" in verify):
        return None, "invalid"
    return result, "ok"


def parse_review(text: str) -> tuple:
    """Read the critic's line: `REVIEW: {p0, p1, notes}`, each a list of strings."""
    if REVIEW_MARKER not in text.upper():
        return None, "missing"
    review = _json_after(text, REVIEW_MARKER)
    if not isinstance(review, dict):
        return None, "invalid"
    for key in ("p0", "p1", "notes"):
        if key in review and not (isinstance(review[key], list)
                                  and all(isinstance(item, str) for item in review[key])):
            return None, "invalid"
    if not isinstance(review.get("p0"), list) or not isinstance(review.get("p1"), list):
        return None, "invalid"
    return review, "ok"


def run_review(lane_dir: Path, record: dict, lane: str) -> dict | None:
    """One read-only pass over the lane by a critic on another model.

    The lane's own model carries the author's blind spots; this one reads the brief, the diff and the
    lane's claim, and reports only what breaks. It is billed into `review.usage`, never into the lane.
    """
    worktree = Path(str(record.get("worktree") or ""))
    repo = str(record.get("repo") or "")
    branch = str(record.get("branch") or "")
    if not worktree.is_dir() or not repo:
        return None
    base = str(record.get("base_sha") or "")
    if not base:
        rc, out, _ = _git(repo, "merge-base", _default_branch(repo), branch)
        if rc == 0 and out:
            base = out
    rc, diff, err = _git(str(worktree), "diff", base or "HEAD")
    if rc != 0:
        print(f"{lane}: review — git says: {err}", file=sys.stderr)
        return None
    if not diff.strip():
        # Nothing to read is not a finding: a lane merged before this record kept its base gives an
        # empty diff, and a critic asked about nothing invents a P0.
        print(f"{lane}: review — no diff against {str(base)[:7] or 'HEAD'}; skipped", file=sys.stderr)
        return None
    rc, status, _ = _git(str(worktree), "status", "--porcelain")
    if len(diff) > 60000:
        diff = diff[:60000] + "\n… diff cut at 60000 characters\n"
    prompt = REVIEW_PROMPT.format(
        brief=" ".join(str(record.get("task") or "").split())[:4000],
        touches=", ".join(record.get("touches") or []) or "(none declared)",
        result=json.dumps(record.get("result"), ensure_ascii=False) if record.get("result") else "(none)",
        status=status[:4000] or "(clean)",
        diff=diff or "(no changes against the base)",
    )
    provider = str(record.get("review_provider") or DEFAULT_REVIEW_PROVIDER)
    model = str(record.get("review_model") or DEFAULT_REVIEW_MODEL)
    load_env_keys()
    cmd = [
        "pi", "-p", "-nt", "--no-session", "--mode", "json",
        "--provider", provider, "--model", model, "--thinking", "low", prompt,
    ]
    started = time.monotonic()
    try:
        done = subprocess.run(
            cmd, capture_output=True, text=True, timeout=REVIEW_TIMEOUT,
            stdin=subprocess.DEVNULL, cwd=str(worktree), check=False,
        )
    except subprocess.TimeoutExpired:
        print(f"{lane}: review — the critic timed out after {REVIEW_TIMEOUT}s", file=sys.stderr)
        return None
    text = ""
    usage = {"input": 0, "output": 0, "cache_read": 0, "cost_usd": 0.0, "turns": 0}
    for line in done.stdout.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") != "message_end":
            continue
        message = event.get("message") or {}
        if message.get("role") != "assistant":
            continue
        said = assistant_text(event)
        if said:
            text = said
        raw = message.get("usage")
        if isinstance(raw, dict):
            usage["input"] += int(raw.get("input") or 0)
            usage["output"] += int(raw.get("output") or 0)
            usage["cache_read"] += int(raw.get("cacheRead") or 0)
            usage["cost_usd"] = round(usage["cost_usd"]
                                      + float((raw.get("cost") or {}).get("total") or 0), 6)
            usage["turns"] += 1
    review, review_status = parse_review(text)
    payload = {
        "status": review_status,
        "p0": (review or {}).get("p0") or [],
        "p1": (review or {}).get("p1") or [],
        "notes": (review or {}).get("notes") or [],
        "provider": provider,
        "model": model,
        "seconds": int(time.monotonic() - started),
        "usage": usage,
        "at": int(time.time()),
    }
    if review_status != "ok":
        payload["said"] = text[:2000]
    (lane_dir / "review.json").write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
                                          encoding="utf-8")
    record["review"] = payload
    record["review_status"] = review_status
    write_record(lane_dir, record)
    return payload


def normalise_touch(pattern: str) -> str:
    """One declared write-set as a repository-relative glob."""
    cleaned = str(pattern or "").strip().replace("\\\\", "/")
    while cleaned.startswith("./"):
        cleaned = cleaned[2:]
    return cleaned.lstrip("/")


def touch_overlap(left: list, right: list) -> list:
    """The globs of two lanes that can name the same file. Worktrees stop write races, not semantics."""
    hits: set = set()
    for first in left:
        for second in right:
            if first == second:
                hits.add(first)
                continue
            plain_first = first.rstrip("*").rstrip("/")
            plain_second = second.rstrip("*").rstrip("/")
            if not plain_first or not plain_second:
                continue
            if plain_first.startswith(plain_second) or plain_second.startswith(plain_first):
                hits.add(first if len(first) <= len(second) else second)
    return sorted(hits)


def dry_merge(argv: list) -> int:
    """Merge branches in memory with `git merge-tree` and report what would conflict.

    A real merge of a lane whose sibling touched the same lines either conflicts or, worse, drops one
    side's reasoning. This answers the question before anything lands.
    """
    parser = argparse.ArgumentParser(prog="pi-lane dry-merge")
    parser.add_argument("lanes", nargs="+")
    args = parser.parse_args(argv)
    records = []
    for name in args.lanes:
        record = read_json(hermes_home() / "lanes" / name / "lane.json")
        if record is None:
            print(f"no such lane: {name}", file=sys.stderr)
            return 1
        records.append(record)
    repos = {str(r.get("repo") or "") for r in records}
    if len(repos) != 1:
        print("dry-merge: lanes come from different repositories", file=sys.stderr)
        return 1
    repo = repos.pop()
    if not repo:
        print("dry-merge: a lane has no repository", file=sys.stderr)
        return 1
    conflicts = 0
    pairs = [(records[0].get("branch"), "HEAD")]
    for previous, following in zip(records, records[1:]):
        pairs.append((previous.get("branch"), following.get("branch")))
    
    for first, second in pairs:
        done = subprocess.run(
            ["git", "-C", repo, "merge-tree", "--write-tree", str(first), str(second)],
            capture_output=True, text=True, check=False,
        )
        label = f"{first} into {second}"
        if done.returncode == 0:
            print(f"clean     {label}")
            continue
        conflicts += 1
        names = sorted({
            line.split(" in ")[-1].strip()
            for line in done.stdout.splitlines()
            if line.startswith("CONFLICT")
        })
        print(f"CONFLICT  {label}" + (f": {', '.join(names[:8])}" if names else ""))
        for line in done.stdout.splitlines():
            if line.startswith("CONFLICT"):
                print(f"          {line}")
    return 1 if conflicts else 0


def assistant_texts(lane_dir) -> list:
    """The lane's own final texts, oldest first, read from the tail of its event stream."""
    path = Path(lane_dir) / "events.jsonl"
    out: list = []
    try:
        lines = path.read_text(errors="replace").splitlines()[-400:]
    except OSError:
        return out
    for line in lines:
        try:
            event = json.loads(line)
        except Exception:
            continue
        if isinstance(event, dict) and event.get("type") == "message_end":
            text = assistant_text(event)
            if text and text.strip():
                out.append(text.strip())
    return out


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def _git(repo: str, *args: str) -> tuple:
    done = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    return done.returncode, done.stdout.strip(), done.stderr.strip()


def _default_branch(repo: str) -> str:
    rc, out, _ = _git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if rc == 0 and out:
        return out.split("/", 1)[-1]
    for candidate in ("main", "master"):
        rc, _, _ = _git(repo, "rev-parse", "--verify", "--quiet", candidate)
        if rc == 0:
            return candidate
    return ""


def _shortstat(repo: str, sha: str) -> tuple:
    rc, out, _ = _git(repo, "show", "--shortstat", "--format=", sha)
    if rc != 0:
        return 0, 0, 0
    files = re.search(r"(\d+) files? changed", out)
    added = re.search(r"(\d+) insertions?\+?\)?", out)
    removed = re.search(r"(\d+) deletions?", out)
    return (
        int(files.group(1)) if files else 0,
        int(added.group(1)) if added else 0,
        int(removed.group(1)) if removed else 0,
    )


def pi_session_dir(worktree: Path) -> Path:
    """Where pi keeps the session of a lane: one folder per worktree path, encoded."""
    key = str(worktree.resolve()).lstrip("/").replace("/", "-")
    return Path.home() / ".pi" / "agent" / "sessions" / f"--{key}--"


def pi_session_files(worktree: Path, session_id: str) -> list:
    folder = pi_session_dir(worktree)
    if not folder.is_dir():
        return []
    return sorted(folder.glob(f"*_{session_id}.jsonl"))


def auto_answer(question: dict) -> tuple:
    """The runner's own reply to a dialog when the lane runs autonomously: `(payload, why)`.

    A lane that stops for a person costs waiting time; in `auto` it decides and the decision goes into
    its thread, so the choice can be audited instead of guessed. A destructive confirmation is always
    refused: nothing is deleted unattended.
    """
    method = str(question.get("method") or "")
    options = [str(option) for option in (question.get("options") or [])]
    text = " ".join(str(question.get(key) or "") for key in ("title", "message")).lower()
    if method == "select":
        pick = options[0] if options else ""
        return {"value": pick}, f"first option: {pick or '(none offered)'}"
    if method == "confirm":
        if any(word in text for word in DESTRUCTIVE_WORDS):
            nope = next((o for o in options if o.strip().lower() in ("no", "cancel", "abort")), "")
            return {"value": nope or "No"}, "refused — the dialog names a destructive action"
        yes = next((o for o in options if o.strip().lower() in ("yes", "ok", "continue", "allow")), "")
        return {"value": yes or "Yes"}, "allowed — nothing destructive in the dialog"
    return {"cancelled": True}, "no value supplied — the lane decides and states the assumption"


def _auto_close_blockers(name: str, record: dict) -> list:
    """Why an autonomous close must not happen yet: an empty list means gate, critic and merge agree."""
    blockers = []
    repo = str(record.get("repo") or "")
    branch = str(record.get("branch") or f"lane/{name}")
    if not repo or not Path(repo).is_dir():
        return ["no repository"]
    rc, head, _ = _git(repo, "rev-parse", "HEAD")
    checked = str(record.get("checked_sha") or "")
    if rc != 0 or not checked:
        blockers.append("no gate recorded")
    elif checked != head:
        blockers.append(f"the gate ran at {checked[:7]}, HEAD is {head[:7]}")
    review = record.get("review") or {}
    if str(record.get("review_status") or "") != "ok":
        blockers.append("no critic review")
    elif review.get("p0"):
        blockers.append(f"the critic reported {len(review['p0'])} P0")
    rc, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, "HEAD")
    if rc != 0:
        done = subprocess.run(["git", "-C", repo, "merge-tree", "--write-tree", "HEAD", branch],
                              capture_output=True, text=True, check=False)
        if done.returncode != 0:
            blockers.append("the merge would conflict")
    return blockers


def close_lanes(argv: list) -> int:
    """Close lanes for good: merge their branch, then write the closed marker.

    Nothing lands on the shelf by accident — this is the only path into it.
    """
    parser = argparse.ArgumentParser(prog="pi-lane close")
    parser.add_argument("lanes", nargs="+")
    parser.add_argument("--no-merge", action="store_true", help="record the close without merging")
    parser.add_argument("--reason", default="", help="why it is closed; defaults to the merge")
    parser.add_argument("--keep", action="store_true", help="keep the worktree, branch and lane folder")
    parser.add_argument("--yes", action="store_true", help="confirm the deletion; without it only the plan prints")
    parser.add_argument("--auto", action="store_true",
                        help="merge and close without a word when the gate, the critic and the merge agree")
    args = parser.parse_args(argv)

    root = hermes_home() / "lanes"
    failed = 0
    for name in args.lanes:
        lane_dir = root / name
        record = read_json(lane_dir / "lane.json")
        if not record:
            print(f"{name}: no such lane", file=sys.stderr)
            failed += 1
            continue
        if record.get("closed_at"):
            print(f"{name}: already closed")
            continue
        repo = str(record.get("repo") or "")
        branch = str(record.get("branch") or f"lane/{name}")
        worktree = Path(str(record.get("worktree") or ""))
        state = str(record.get("state") or "")
        if state == "running" and pid_alive(record.get("pid")):
            print(f"{name}: still running — stop it first", file=sys.stderr)
            failed += 1
            continue

        if args.auto:
            blockers = _auto_close_blockers(name, record)
            if blockers:
                print(f"{name}: not closed — {', '.join(blockers)}", file=sys.stderr)
                failed += 1
                continue
            print(f"{name}: auto-close — gate and critic agree, merging without a word")
            args.yes = True

        if not args.yes and not args.no_merge:
            # Say exactly what disappears before anything does.
            default_name = _default_branch(repo) if repo and Path(repo).is_dir() else "?"
            rc_c, commits, _ = _git(worktree, "rev-list", "--count", f"{default_name}..HEAD") if worktree.is_dir() else (1, "0", "")
            rc_d, dirty, _ = _git(str(worktree), "status", "--porcelain") if worktree.is_dir() else (1, "", "")
            changed = len([l for l in dirty.splitlines() if l.strip()])
            size = 0
            if lane_dir.is_dir():
                size = sum(f.stat().st_size for f in lane_dir.rglob("*") if f.is_file())
            print(f"{name}: nothing done yet — this is the plan")
            print(f"  merge   {branch} → {default_name}"
                  + (f" ({commits.strip()} commits)" if worktree.is_dir() else " (no worktree)"))
            print(f"  commit  {changed} uncommitted file(s) from the lane" if changed else "  commit  nothing uncommitted")
            print(f"  delete  worktree {worktree}" if worktree.is_dir() else "  delete  no worktree")
            print(f"  delete  branch {branch}")
            print(f"  delete  folder {lane_dir} ({size // 1024}K)")
            sessions = pi_session_files(worktree, str(record.get("session_id") or "")) if worktree.is_dir() else []
            session_kb = sum(f.stat().st_size for f in sessions) // 1024
            print(f"  delete  pi session {pi_session_dir(worktree)} ({session_kb}K)" if sessions or worktree.is_dir()
                  else "  delete  no pi session")
            print(f"  keep    one receipt line in {(root / 'closed.jsonl')}")
            print("")
            print("  Nothing is lost. The work lands in the main branch as commits, and every one of")
            print("  them stays in the history: it can be shown, copied or turned into a new branch")
            print("  later. The worktree, the branch and the folder go only to free space and to keep")
            print("  the panel free of dead lanes — the code itself lives on in the main branch.")
            print("")
            print(f"  rerun with --yes to carry it out")
            continue

        # A lane does not commit, so its work is still uncommitted here: commit it on the lane
        # branch before the merge, or the merge would carry nothing.
        if worktree.is_dir():
            rc_s, dirty, _ = _git(str(worktree), "status", "--porcelain")
            if rc_s == 0 and dirty.strip():
                _git(str(worktree), "add", "-A")
                summary = str(record.get("task") or name).strip().splitlines()[0][:70]
                _git(
                    str(worktree), "-c", "user.name=pi-lane", "-c", "user.email=pi-lane@local",
                    "commit", "-m", f"Lane {name}: {summary}",
                )
                print(f"{name}: committed its work on {branch}")

        default = _default_branch(repo) if repo and Path(repo).is_dir() else ""
        merged_sha = ""
        merged_subject = ""
        merged_date = ""
        reason = args.reason
        if default and not args.no_merge:
            rc, _, _ = _git(repo, "rev-parse", "--verify", "--quiet", branch)
            if rc == 0:
                rc_merged, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, default)
                if rc_merged != 0:
                    rc_m, out_m, err_m = _git(repo, "merge", "--no-ff", branch, "-m", f"Merge lane {name}")
                    if rc_m != 0:
                        print(f"{name}: merge failed — {err_m or out_m}", file=sys.stderr)
                        failed += 1
                        continue
                rc_s, sha, _ = _git(repo, "rev-parse", default)
                if rc_s == 0:
                    merged_sha = sha
                    _, subject, _ = _git(repo, "log", "-1", "--format=%s", sha)
                    merged_subject = subject
                    _, date, _ = _git(repo, "log", "-1", "--format=%ad", "--date=short", sha)
                    merged_date = date
                reason = reason or f"closed after merge into {default}"
        if not reason:
            reason = "closed by hand"

        record["closed_at"] = int(time.time())
        record["closed_reason"] = reason
        if merged_sha:
            files, added, removed = _shortstat(repo, merged_sha)
            record.update({
                "merge_sha": merged_sha,
                "merge_subject": merged_subject,
                "closed_date": merged_date,
                "merge_files": files,
                "merge_insertions": added,
                "merge_deletions": removed,
            })
        lane_dir.mkdir(parents=True, exist_ok=True)
        (lane_dir / "lane.json").write_text(json.dumps(record, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        # One line for the journal, so closed lanes stay visible after their folder is gone.
        receipt = {
            "lane": name,
            "project": record.get("project"),
            "group": record.get("group"),
            "branch": branch,
            "state": state or "done",
            "closed_at": record["closed_at"],
            "closed_reason": reason,
            "merge_sha": merged_sha,
            "merge_subject": merged_subject,
            "closed_date": merged_date,
            "merge_files": record.get("merge_files", 0),
            "merge_insertions": record.get("merge_insertions", 0),
            "merge_deletions": record.get("merge_deletions", 0),
            "base": default,
        }
        (root / "closed.jsonl").open("a", encoding="utf-8").write(
            json.dumps(receipt, ensure_ascii=False) + "\n"
        )

        cleaned = []
        if not args.keep:
            if worktree.is_dir():
                rc_w, _, err_w = _git(repo, "worktree", "remove", "--force", str(worktree))
                cleaned.append("worktree" if rc_w == 0 else f"worktree kept ({err_w})")
            if branch and repo:
                rc_b, _, _ = _git(repo, "branch", "-d", branch)
                if rc_b != 0:
                    _git(repo, "branch", "-D", branch)
                cleaned.append("branch")
            for leftover in (lane_dir / "events.jsonl", lane_dir / "stderr.txt", lane_dir / "thread.jsonl",
                             lane_dir / "lane.json", lane_dir / "question.json", lane_dir / "answer.json"):
                leftover.unlink(missing_ok=True)
            try:
                lane_dir.rmdir()
                cleaned.append("lane folder")
            except OSError:
                pass
            # pi keeps its own history beside the worktree: without this the folder outlives
            # the lane and turns into a 90K orphan per lane.
            session_files = pi_session_files(worktree, str(record.get("session_id") or ""))
            for item in session_files:
                item.unlink(missing_ok=True)
            folder = pi_session_dir(worktree)
            if session_files and folder.is_dir():
                try:
                    folder.rmdir()
                except OSError:
                    pass
            if session_files:
                cleaned.append("pi session")

        extra = f" · merged {merged_sha[:7]} into {default}" if merged_sha else ""
        tail = f" · removed {', '.join(cleaned)}" if cleaned else ""
        print(f"{name}: closed{extra}{tail}")

    return 1 if failed else 0


def check_lane(argv: list) -> int:
    """Record that the orchestrator read this lane's work: `checked_at` and the worktree's HEAD.

    The panel shows a lane as `reviewed` — and offers its CLOSE control — only while that sha is still the
    worktree's HEAD, so a check can never stand for work that landed after it.
    """
    parser = argparse.ArgumentParser(prog="pi-lane check")
    parser.add_argument("lane")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    worktree = str(record.get("worktree") or "")
    if not worktree or not Path(worktree).is_dir():
        print(f"{args.lane}: no worktree to check", file=sys.stderr)
        return 1
    rc, sha, err = _git(worktree, "rev-parse", "HEAD")
    if rc != 0:
        print(f"{args.lane}: git says: {err}", file=sys.stderr)
        return 1
    record["checked_at"] = int(time.time())
    record["checked_sha"] = sha
    write_record(lane_dir, record)
    print(f"{args.lane}: checked at {sha[:7]}")
    return 0


def say_in_thread(argv: list) -> int:
    """Append an orchestrator reply into a lane's thread. Nothing is sent to pi."""
    parser = argparse.ArgumentParser(prog="pi-lane say")
    parser.add_argument("lane")
    parser.add_argument("text")
    args = parser.parse_args(argv)
