    os.replace(tmp, lane_dir / "answer.json")
    print(f"{args.lane}: answered")
    return 0


def list_lanes(argv: list) -> int:
    """Print lanes with the state the panel shows, so an agent can pick one without the UI."""
    rows = []
    for record in lane_records():
        rows.append(record)
    rows.sort(key=lambda r: r.get("started") or 0, reverse=True)
    if not rows:
        print("no lanes")
        return 0
    for r in rows:
        if r.get("closed_at"):
            shelf = "closed"
        elif r.get("handed_at"):
            shelf = "review"
        else:
            shelf = str(r.get("state") or "?")
        print(f"{r.get('lane')}\t{shelf}\t{r.get('project') or '-'}\t{(r.get('task') or '')[:60]}")
    return 0


def _lane_state(lane: str) -> tuple[str, dict | None, dict | None]:
    lane_dir = hermes_home() / "lanes" / lane
    record = read_json(lane_dir / "lane.json")
    question = read_json(lane_dir / "question.json") if record and record.get("state") == "waiting" else None
    return (str(record.get("state") or "") if record else "gone"), record, question


def _report_lane(lane: str, state: str, record: dict | None, question: dict | None,
                 files: int, added: int, removed: int, as_json: bool) -> None:
    if as_json:
        print(json.dumps({
            "lane": lane, "state": state, "files": files, "insertions": added,
            "deletions": removed, "closed": bool((record or {}).get("closed_at")),
            "question": ({"id": question.get("id"), "title": question.get("title") or question.get("message") or ""}
                         if isinstance(question, dict) else None),
        }, ensure_ascii=False))
    elif question is not None:
        print(f"{lane}: waiting — {question.get('title') or question.get('message') or ''}")
    elif state == "done":
        print(f"{lane}: done — {files} files +{added} -{removed}")
    else:
        print(f"{lane}: {state}")


def wait_all(argv: list) -> int:
    """Wait for several lanes at once.

    `pi-lane wait --all` follows every lane that is running or waiting; names may narrow it.
    Returns 3 as soon as ANY lane is waiting on a question, because that one needs a person
    before the others can be merged. This is the verb that makes parallel lanes affordable:
    start three, wait on all three, merge in dependency order.
    """
    parser = argparse.ArgumentParser(prog="pi-lane wait --all")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("lanes", nargs="*")
    parser.add_argument("--timeout", type=int, default=3600, help="seconds; 0 waits forever")
    parser.add_argument("--interval", type=float, default=3.0)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    watch = list(args.lanes)
    if not watch:
        for record in lane_records():
            if str(record.get("state") or "") in ("running", "waiting"):
                watch.append(str(record.get("lane")))
    if not watch:
        if args.json:
            print(json.dumps({"lanes": [], "state": "empty"}))
        else:
            print("no lanes to wait for")
        return 0

    deadline = (time.monotonic() + args.timeout) if args.timeout else None
    printed: dict[str, str] = {}
    while True:
        states: dict[str, str] = {}
        waiting: list[str] = []
        failed = False
        for lane in watch:
            state, record, question = _lane_state(lane)
            if state in ("running", "waiting") and record is not None and not pid_alive(record.get("pid")):
                print(f"{lane}: orphaned — its runner is gone; `pi-lane resume {lane}` picks it up",
                      file=sys.stderr)
                states[lane] = "orphaned"
                failed = True
                continue
            states[lane] = state
            if question is not None:
                waiting.append(lane)
            if state in ("failed", "error"):
                failed = True
            if printed.get(lane) != state or question is not None:
                files = added = removed = 0
                if record and record.get("repo") and record.get("branch"):
                    try:
                        files, added, removed = _shortstat(str(record["repo"]), str(record["branch"]))
                    except Exception:
                        pass
                _report_lane(lane, state, record, question, files, added, removed, args.json)
                printed[lane] = state
        if waiting:
            return 3
        if all(s in ("done", "failed", "stopped", "cancelled", "error", "gone") for s in states.values()):
            if not args.json:
                done = sum(1 for s in states.values() if s == "done")
                print(f"all settled — {done}/{len(watch)} done")
            return 1 if failed else 0
        if deadline is not None and time.monotonic() > deadline:
            pending = ", ".join(f"{k}={v}" for k, v in states.items() if v in ("running", "waiting"))
            print(f"timeout after {args.timeout}s — still: {pending}", file=sys.stderr)
            return 124
        time.sleep(args.interval)


def wait_lane(argv: list) -> int:
    """Block until a lane stops moving on its own: done, failed, or waiting on a question.

    This is what an orchestrator needs instead of `sleep 180` in a loop. Exit codes are the
    contract: 0 terminal state, 3 the lane is waiting for an answer, 124 timeout.
    """
    parser = argparse.ArgumentParser(prog="pi-lane wait")
    parser.add_argument("lane")
    parser.add_argument("--timeout", type=int, default=3600, help="seconds; 0 waits forever")
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    deadline = (time.monotonic() + args.timeout) if args.timeout else None
    seen_printed = ""
    while True:
        record = read_json(lane_dir / "lane.json")
        if record is None:
            if args.json:
                print(json.dumps({"lane": args.lane, "state": "gone"}))
            else:
                print(f"no such lane: {args.lane}", file=sys.stderr)
            return 1
        state = str(record.get("state") or "")
        if state in ("running", "waiting") and not pid_alive(record.get("pid")):
            message = (f"{args.lane}: orphaned — its runner is gone (pid {record.get('pid')}); "
                       f"`pi-lane resume {args.lane}` picks it up")
            if args.json:
                print(json.dumps({"lane": args.lane, "state": "orphaned", "question": None}))
            else:
                print(message)
            return 1
        files = added = removed = 0
        repo = str(record.get("repo") or "")
        branch = str(record.get("branch") or "")
        if repo and branch:
            try:
                files, added, removed = _shortstat(repo, branch)
            except Exception:
                pass
        question = None
        if state == "waiting":
            q = read_json(lane_dir / "question.json")
            if isinstance(q, dict):
                question = {"id": q.get("id"), "title": q.get("title") or q.get("message") or ""}
        if args.json:
            payload = {"lane": args.lane, "state": state, "files": files,
                       "insertions": added, "deletions": removed,
                       "closed": bool(record.get("closed_at")), "question": question}
            print(json.dumps(payload, ensure_ascii=False))
        elif state != seen_printed:
            # One line per state change: a poll loop that repeats itself is noise in an agent's context.
            seen_printed = state
            if question is not None:
                print(f"{args.lane}: waiting — {question['title']}")
            elif state == "done":
                print(f"{args.lane}: done — {files} files +{added} -{removed}")
            else:
                print(f"{args.lane}: {state}")
        if question is not None:
            return 3
        if state in ("done", "failed", "stopped", "cancelled", "error") or record.get("closed_at"):
            return 0 if state == "done" or record.get("closed_at") else 1
        if deadline is not None and time.monotonic() > deadline:
            print(f"{args.lane}: timeout after {args.timeout}s in state {state}", file=sys.stderr)
            return 124
        time.sleep(args.interval)


def gate_lanes(argv: list) -> int:
    """Run the project gates in the MERGED tree and record the check on each lane.

    Two refusals make this verb worth having. A lane whose branch is not yet an ancestor of HEAD
    was never merged, so a green run here would bless work that is not in the tree. And lanes from
    different repositories cannot share one gate run, because one command set would answer for both.
    On success it writes `checked_at` and `checked_sha` — the same pair the panel reads to offer
    CLOSE.
    """
    parser = argparse.ArgumentParser(prog="pi-lane gate")
    parser.add_argument("lanes", nargs="+")
    parser.add_argument("--cmd", action="append", default=[], help="a gate command; repeatable")
    parser.add_argument("--cwd", default="", help="run here instead of the repository root")
    parser.add_argument("--timeout", type=int, default=1800, help="seconds per command")
    args = parser.parse_args(argv)
    if not args.cmd:
        print("pi-lane gate: pass at least one --cmd \"<command>\"", file=sys.stderr)
        return 2

    records = {}
    repos = set()
    for lane in args.lanes:
        record = read_json(hermes_home() / "lanes" / lane / "lane.json")
        if record is None:
            print(f"{lane}: no such lane", file=sys.stderr)
            return 1
        if record.get("closed_at"):
            print(f"{lane}: already closed", file=sys.stderr)
            return 1
        repo = str(record.get("repo") or "")
        if not repo:
            print(f"{lane}: the record carries no repository", file=sys.stderr)
            return 1
        records[lane] = record
        repos.add(os.path.realpath(repo))
    if len(repos) != 1:
        print(f"lanes span {len(repos)} repositories: {', '.join(sorted(repos))}", file=sys.stderr)
        return 1
    repo = repos.pop()
    workdir = os.path.realpath(args.cwd) if args.cwd else repo

    rc, head, err = _git(repo, "rev-parse", "HEAD")
    if rc != 0:
        print(f"{repo}: git says: {err}", file=sys.stderr)
        return 1

    # The whole point: a gate that runs next to unmerged work proves nothing about the tree.
    unmerged = []
    for lane, record in records.items():
        branch = str(record.get("branch") or "")
        if not branch:
            continue
        rc, _, _ = _git(repo, "merge-base", "--is-ancestor", branch, "HEAD")
        if rc != 0:
            unmerged.append(lane)
    if unmerged:
        print(f"refusing: not merged into HEAD ({head[:7]}): {', '.join(sorted(unmerged))}", file=sys.stderr)
        print("merge them first — a gate here would bless work that is not in the tree", file=sys.stderr)
        return 1

    started = time.time()
    for command in args.cmd:
        print(f"$ {command}   (in {workdir})")
        try:
            done = subprocess.run(command, shell=True, cwd=workdir, capture_output=True, text=True,
                                  timeout=args.timeout)
        except subprocess.TimeoutExpired:
            print(f"timeout after {args.timeout}s: {command}", file=sys.stderr)
            return 1
        output = ((done.stdout or "") + (done.stderr or "")).strip()
        tail = "\n".join(output.splitlines()[-12:])
        if tail:
            print(tail)
        print(f"-> exit {done.returncode}")
        if done.returncode != 0:
            print(f"gate failed, nothing recorded: {command}", file=sys.stderr)
            return 1

    for lane, record in records.items():
        record["checked_at"] = int(time.time())
        record["checked_sha"] = head
        record["gate_cmds"] = list(args.cmd)
        record["gate_seconds"] = int(time.time() - started)
        write_record(hermes_home() / "lanes" / lane, record)
    print(f"gate ok — checked {len(records)} lane(s) at {head[:7]}")
    return 0


def review_queue(argv: list) -> int:
    """Print the review shelf: the lanes a person filed, with everything a check needs.

    This is the pull half of the panel's `SEND`: nothing is injected into a chat, the orchestrator
    asks for the queue when it wants to work. Same fields the injected message carried.
    """
    parser = argparse.ArgumentParser(prog="pi-lane review")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    rows = [r for r in lane_records() if r.get("handed_at") and not r.get("closed_at")]
    rows.sort(key=lambda r: r.get("handed_at") or 0)
    if args.json:
        print(json.dumps([{k: r.get(k) for k in ("lane", "project", "group", "state", "task",
                                                 "files", "insertions", "deletions", "worktree")}
                          for r in rows], ensure_ascii=False))
        return 0
    if not rows:
        print("review queue: empty")
        return 0
    print(f"Review queue: {len(rows)} lane(s).")
    for r in rows:
        print(f"- {r.get('project') or '?'}/{r.get('group') or '-'}/{r.get('lane')} — {r.get('state')}"
              f" — {r.get('files', 0)} files +{r.get('insertions', 0)} -{r.get('deletions', 0)}")
        if r.get("task"):
            # The record's `task` is the full brief a lane was given; print its point, not its length.
            head = " ".join(str(r["task"]).split())[:140]
            print(f"  task: {head}")
        texts = assistant_texts(hermes_home() / "lanes" / str(r.get("lane")))
        if texts:
            print(f"  says: {' '.join(texts[-1].split())[:240]}")
        if r.get("worktree"):
            print(f"  look: {r['worktree']} · pi-lane check {r.get('lane')}")
    print("\nCheck each one, report what you found, and wait for his go before closing.")
    return 0


def digest_lane(argv: list) -> int:
    """Print one lane as a compact record: task, commits, diff size, gate result, leftovers.

    The point is to make a later 'write a skill from this' cost one call instead of a re-read of
    the repository.
    """
    parser = argparse.ArgumentParser(prog="pi-lane digest")
    parser.add_argument("lane")
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    repo = str(record.get("repo") or "")
    branch = str(record.get("branch") or "")
    print(f"lane      {record.get('lane')}  ({record.get('state')})")
    print(f"project   {record.get('project') or '-'} / {record.get('group') or '-'}")
    print(f"task      {' '.join(str(record.get('task') or '').split())[:300]}")
    print(f"model     {record.get('provider') or '?'} / {record.get('model') or '?'}")
    if record.get("handed_at"):
        print(f"handed    yes")
    if record.get("checked_at"):
        print(f"checked   {str(record.get('checked_sha'))[:7]} · {'; '.join(record.get('gate_cmds') or [])}")
    usage = record.get("usage") or _usage_from_session(str(record.get("worktree") or "")) or {}
    if usage:
        print(f"usage     in {int(usage.get('input') or 0)} · out {int(usage.get('output') or 0)} · "
              f"cache {int(usage.get('cache_read') or 0)} · ${float(usage.get('cost_usd') or 0):.4f} · "
              f"{int(usage.get('turns') or 0)} turns")
    if record.get("stop_reason"):
        print(f"stopped   {record['stop_reason']}")
    touches = record.get("touches") or []
    if touches:
        print(f"touches   {', '.join(touches)}")
    review = record.get("review") or {}
    if review:
        print(f"review    {review.get('model')} — P0 {len(review.get('p0') or [])} · "
              f"P1 {len(review.get('p1') or [])} · ${float((review.get('usage') or {}).get('cost_usd') or 0):.4f}")
        for item in (review.get("p0") or [])[:3]:
            print(f"  P0 {item}")
        for item in (review.get("p1") or [])[:3]:
            print(f"  P1 {item}")
    status = str(record.get("result_status") or "")
    if status:
        result = record.get("result") or {}
        line = f"result    {status}"
        if result:
            line += f" · {len(result.get('files') or [])} file(s)"
            verify = result.get("verify") or {}
            if verify:
                line += f" · verify exit {verify.get('exit')}"
            if result.get("risks"):
                line += f" · {len(result['risks'])} risk(s)"
        print(line)
        if result.get("followups"):
            print("next      " + "; ".join(str(item) for item in result["followups"][:4]))
    if record.get("last_error"):
        print(f"error     {str(record.get('last_error'))[:200]}")
    if repo and branch:
        rc, log, _ = _git(repo, "log", "--oneline", f"-8", branch)
        if rc == 0 and log:
            print("commits   " + "\n          ".join(log.splitlines()))
        rc, base, _ = _git(repo, "merge-base", branch, "HEAD")
        if rc == 0:
            rc2, stat, _ = _git(repo, "diff", "--stat", f"{base[:12]}..{branch}")
            if rc2 == 0 and stat:
                print("diff      " + "\n          ".join(stat.splitlines()[-4:]))
    texts = assistant_texts(lane_dir)
    if texts:
        print(f"says      {' '.join(texts[-1].split())[:300]}")
    return 0


def run_session(lane_dir: Path, record: dict, lane: str, worktree: Path, task: str, question_timeout: int) -> int:
    """One `pi --mode rpc` turn: the lane's first task or a continuation of its session.

    Budget: `record["budget"]` caps the whole lane across continuations — `max_usd` and `max_turns` per
    run, `idle_timeout` seconds without an event. A breach ends the run with state `stopped` and a
    `stop_reason`, so a lane that loops on a failing test cannot spend the night.
    """
    events_path = lane_dir / "events.jsonl"
    stderr_path = lane_dir / "stderr.txt"
    question_path = lane_dir / "question.json"
    answer_path = lane_dir / "answer.json"
    text = ""
    cmd = [
        "pi", "--mode", "rpc", "--session-id", record["session_id"],
        "--provider", record["provider"], "--model", record["model"], "--thinking", record.get("thinking") or DEFAULT_THINKING,
    ]
    text = ""
    exit_code = 0
    finished = False
    budget = record.get("budget") or {}
    autonomy = str(record.get("autonomy") or DEFAULT_AUTONOMY)
    max_usd = float(budget.get("max_usd") or 0)
    max_turns = int(budget.get("max_turns") or 0)
    idle_timeout = int(budget.get("idle_timeout") or 0)
    usage = dict(record.get("usage") or {
        "input": 0, "output": 0, "cache_read": 0, "cache_write": 0,
        "reasoning": 0, "cost_usd": 0.0, "turns": 0,
    })
    turns_here = 0
    stop_reason = ""

    with stderr_path.open("a", encoding="utf-8") as stderr_handle, events_path.open(
        "a", encoding="utf-8"
    ) as events:
        proc = subprocess.Popen(
            cmd, cwd=str(worktree), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=stderr_handle, text=True, bufsize=1,
        )
        assert proc.stdin is not None and proc.stdout is not None
        proc.stdin.write(json.dumps({"type": "prompt", "message": task}) + "\n")
        proc.stdin.flush()

        question: dict | None = None
        question_since = 0.0
        last_activity = time.monotonic()
        last_beat = time.monotonic()

        while True:
            ready, _, _ = select.select([proc.stdout], [], [], POLL_SECONDS)

            if time.monotonic() - last_beat >= 15:
                # Liveness without noise: `reap` and the panel tell a slow lane from a dead one by
                # the heartbeat and the pid, not by the last state change.
                record["heartbeat"] = int(time.time())
                write_record(lane_dir, record)
                last_beat = time.monotonic()

            if ready:
                last_activity = time.monotonic()
                line = proc.stdout.readline()
                if not line:
                    break
                if _keep_event(line):
                    events.write(line)
                    events.flush()
                try:
                    event = json.loads(line)
                except ValueError:
                    continue

                kind = event.get("type")
                if kind == "message_end":
                    said = assistant_text(event)
                    if said:
                        text = said
                    message = event.get("message") or {}
                    raw = message.get("usage")
                    if isinstance(raw, dict):
                        # The lane's own bill, kept with the record: the panel read it out of the
                        # session file, and nothing wrote it down, so a run could not be totalled.
                        turns_here += 1
                        usage["input"] += int(raw.get("input") or 0)
                        usage["output"] += int(raw.get("output") or 0)
                        usage["cache_read"] += int(raw.get("cacheRead") or 0)
                        usage["cache_write"] += int(raw.get("cacheWrite") or 0)
                        usage["reasoning"] += int(raw.get("reasoning") or 0)
                        usage["cost_usd"] = round(float(usage.get("cost_usd") or 0)
                                                  + float((raw.get("cost") or {}).get("total") or 0), 6)
                        usage["turns"] = int(usage.get("turns") or 0) + 1
                        record["usage"] = usage
                        write_record(lane_dir, record)
                        if max_usd and usage["cost_usd"] >= max_usd:
                            stop_reason = f"max_usd {usage['cost_usd']:.4f} >= {max_usd:g}"
                        elif max_turns and turns_here >= max_turns:
                            stop_reason = f"max_turns {turns_here} >= {max_turns}"
                elif kind == "extension_ui_request" and event.get("method") in DIALOG_METHODS:
                    dialog = {
                        "id": event.get("id"),
                        "method": event.get("method"),
                        "title": event.get("title") or "",
                        "message": event.get("message") or "",
                        "options": event.get("options") or [],
                        "asked_at": int(time.time()),
                    }
                    if autonomy == "auto":
                        reply, why = auto_answer(dialog)
                        reply.update({"type": "extension_ui_response", "id": dialog["id"]})
                        proc.stdin.write(json.dumps(reply) + "\n")
                        proc.stdin.flush()
                        record["auto_answers"] = int(record.get("auto_answers") or 0) + 1
                        write_record(lane_dir, record)
                        with (lane_dir / "thread.jsonl").open("a", encoding="utf-8") as handle:
                            handle.write(json.dumps({
                                "who": "jarvis", "at": int(time.time()),
                                "text": f"auto-answered {dialog['method']}: {why}",
                            }, ensure_ascii=False) + "\n")
                        print(f"{lane}: auto-answered {dialog['method']} — {why}", file=sys.stderr)
                    else:
                        question = dialog
                        question_since = time.monotonic()
                        question_path.write_text(json.dumps(question, indent=2) + "\n", encoding="utf-8")
                        record["state"] = "waiting"
                        write_record(lane_dir, record)
                elif kind == "agent_end":
                    finished = True

            if question is not None:
                if answer_path.exists():
                    try:
                        answer = json.loads(answer_path.read_text(encoding="utf-8"))
                    except (OSError, ValueError):
                        answer = {}
                    if answer.get("id") in (None, question["id"]):
                        payload: dict = {"type": "extension_ui_response", "id": question["id"]}
                        if answer.get("cancelled"):
                            payload["cancelled"] = True
                        else:
                            payload["value"] = str(answer.get("value", ""))
                        proc.stdin.write(json.dumps(payload) + "\n")
                        proc.stdin.flush()
                        question = None
                        question_path.unlink(missing_ok=True)
                        answer_path.unlink(missing_ok=True)
                        record["state"] = "running"
                        write_record(lane_dir, record)
                elif question_timeout and (time.monotonic() - question_since) > question_timeout:
                    proc.stdin.write(json.dumps({
                        "type": "extension_ui_response", "id": question["id"], "cancelled": True,
                    }) + "\n")
                    proc.stdin.flush()
                    question_path.unlink(missing_ok=True)
                    question = None
                    record["state"] = "running"
                    write_record(lane_dir, record)

            if stop_reason:
                break
            if (
                idle_timeout
                and question is None
                and not finished
                and (time.monotonic() - last_activity) > idle_timeout
            ):
                stop_reason = f"idle {idle_timeout}s without an event"
                break
            if finished or proc.poll() is not None:
                break

        # pi in RPC mode is a server: it stays alive after `agent_end`. Drain
        # whatever is already in the pipe, then stop it ourselves.
        while True:
            ready, _, _ = select.select([proc.stdout], [], [], 0.2)
            if not ready:
                break
            line = proc.stdout.readline()
            if not line:
                break
            if _keep_event(line):
                events.write(line)

        try:
            proc.stdin.close()
        except OSError:
            pass
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=10)

        exit_code = int(proc.returncode or 0)

    record["finished"] = int(time.time())
    record["exit"] = exit_code
    record["usage"] = usage
    result, result_status = parse_result(text)
    record["result"] = result
    record["result_status"] = result_status
    if result_status != "ok":
        print(f"{lane}: result {result_status} — a lane ends with a RESULT: {{\"files\": [...]}} line",
              file=sys.stderr)
    if stop_reason:
        record["stop_reason"] = stop_reason
        record["state"] = "stopped"
        print(f"{lane}: stopped — {stop_reason}", file=sys.stderr)
    else:
        record.pop("stop_reason", None)
        record["state"] = "done" if (exit_code == 0 and text) else "failed"
    write_record(lane_dir, record)
    question_path.unlink(missing_ok=True)
    return exit_code


def continue_lane(argv: list) -> int:
    """Add a task to a finished lane by running its own session again."""
    parser = argparse.ArgumentParser(prog="pi-lane continue")
    parser.add_argument("lane")
    parser.add_argument("text")
    parser.add_argument("--question-timeout", type=int, default=1800)
    args = parser.parse_args(argv)

    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if not record:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    if record.get("closed_at"):
        print(f"{args.lane}: closed — open a new lane instead", file=sys.stderr)
        return 1
    if str(record.get("state")) == "running" and pid_alive(record.get("pid")):
        print(f"{args.lane}: still running", file=sys.stderr)
        return 1
    budget = record.get("budget") or {}
    limit = float(budget.get("max_usd") or 0)
    spent = float((record.get("usage") or {}).get("cost_usd") or 0)
    if limit and spent >= limit:
        print(f"{args.lane}: budget spent — ${spent:.4f} of ${limit:g}; raise it with "
              f"`pi-lane budget {args.lane} --max-usd N` or close the lane", file=sys.stderr)
        return 1
    worktree = Path(str(record.get("worktree") or ""))
    if not worktree.is_dir():
        print(f"{args.lane}: its worktree is gone", file=sys.stderr)
        return 1

    with (lane_dir / "thread.jsonl").open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({"who": "user", "at": int(time.time()), "text": args.text}, ensure_ascii=False) + "\n")

    record.pop("closed_at", None)
    record.pop("closed_reason", None)
    record["handed_at"] = None
    record["state"] = "running"
    record["pid"] = os.getpid()
    record["started"] = int(time.time())
    record["exit"] = None
    record["finished"] = None
    write_record(lane_dir, record)
    load_env_keys()
    print(f"{args.lane}: continuing")
    return run_session(lane_dir, record, args.lane, worktree, args.text, args.question_timeout)


def reap(argv: list) -> int:
    """Mark lanes whose runner is gone. A `running` record with a dead pid is a crash, not work.

    Nothing else marks it: the panel keeps drawing such a lane as running, and `wait` used to block on
    it forever. The state becomes `stopped` with a reason that names the cure, because a lane's pi
    session survives on disk and `pi-lane resume` continues it.
    """
    parser = argparse.ArgumentParser(prog="pi-lane reap")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    orphaned = []
    for record in lane_records():
        state = str(record.get("state") or "")
        if state not in ("running", "waiting"):
            continue
        if pid_alive(record.get("pid")):
            continue
        lane = str(record.get("lane") or "")
        if not lane:
            continue
        record["state"] = "stopped"
        record["orphaned_at"] = int(time.time())
        record["stop_reason"] = "runner gone — `pi-lane resume` continues it"
        write_record(hermes_home() / "lanes" / lane, record)
        orphaned.append(lane)
    if args.json:
        print(json.dumps({"orphaned": orphaned}))
    elif orphaned:
        for lane in orphaned:
            print(f"{lane}: orphaned — its runner is gone; `pi-lane resume {lane}` continues it")
    else:
        print("no orphaned lanes")
    return 0


def resume_lane(argv: list) -> int:
    """Pick up a lane whose runner died, in the same pi session.

    A crash leaves the record `running` with a dead pid and the worktree intact. pi keeps the session
    on disk under the lane's session id, so resuming sends the last prompt into that same conversation
    instead of paying for the context again. Budget and usage carry over.
    """
    parser = argparse.ArgumentParser(prog="pi-lane resume")
    parser.add_argument("lane")
    parser.add_argument("--question-timeout", type=int, default=1800)
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    if record.get("closed_at"):
        print(f"{args.lane}: closed — open a new lane instead", file=sys.stderr)
        return 1
    if pid_alive(record.get("pid")) and str(record.get("state")) in ("running", "waiting"):
        print(f"{args.lane}: still running (pid {record.get('pid')}) — nothing to resume", file=sys.stderr)
        return 1
    worktree = Path(str(record.get("worktree") or ""))
    if not worktree.is_dir():
        print(f"{args.lane}: its worktree is gone; open the slice again", file=sys.stderr)
        return 1
    prompt = str(record.get("task") or "")
    thread_path = lane_dir / "thread.jsonl"
    if thread_path.is_file():
        for line in thread_path.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("who") == "user" and str(entry.get("text") or "").strip():
                prompt = str(entry["text"])
    if not prompt:
        print(f"{args.lane}: no prompt to resume", file=sys.stderr)
        return 1
    with thread_path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({
            "who": "jarvis", "at": int(time.time()),
            "text": f"resumed after the runner was gone (was {record.get('state')})",
        }, ensure_ascii=False) + "\n")
    record["state"] = "running"
    record["pid"] = os.getpid()
    record["started"] = int(time.time())
    record["resumed_at"] = int(time.time())
    record["exit"] = None
    record["finished"] = None
    record.pop("stop_reason", None)
    record.pop("orphaned_at", None)
    write_record(lane_dir, record)
    load_env_keys()
    print(f"{args.lane}: resumed in session {record.get('session_id')}")
    return run_session(lane_dir, record, args.lane, worktree, prompt, args.question_timeout)


def set_budget(argv: list) -> int:
    """Change a lane's caps. `max_usd` covers the whole lane, so a spent lane refuses a continuation."""
    parser = argparse.ArgumentParser(prog="pi-lane budget")
    parser.add_argument("lane")
    parser.add_argument("--max-usd", type=float, default=None)
    parser.add_argument("--max-turns", type=int, default=None)
    parser.add_argument("--idle-timeout", type=int, default=None)
    args = parser.parse_args(argv)
    lane_dir = hermes_home() / "lanes" / args.lane
    record = read_json(lane_dir / "lane.json")
    if record is None:
        print(f"no such lane: {args.lane}", file=sys.stderr)
        return 1
    budget = dict(record.get("budget") or {})
    for key, value in (
        ("max_usd", args.max_usd), ("max_turns", args.max_turns), ("idle_timeout", args.idle_timeout),
    ):
        if value is not None:
            budget[key] = value
    record["budget"] = budget
    write_record(lane_dir, record)
    print(f"{args.lane}: budget {json.dumps(budget)}")
    return 0


def _usage_from_session(worktree: str) -> dict | None:
    """Sum a lane's usage from its pi session files, for records written before the runner kept it."""
    if not worktree:
        return None
    folder = hermes_home().parent / ".pi" / "agent" / "sessions" / f"--{worktree.strip('/').replace('/', '-')}--"
    if not folder.is_dir():
        return None
    total = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "reasoning": 0,
             "cost_usd": 0.0, "turns": 0}
    seen = False
    for path in sorted(folder.glob("*.jsonl")):
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                event = json.loads(line)
            except ValueError:
                continue
            message = event.get("message") if isinstance(event.get("message"), dict) else None
            usage = (message or {}).get("usage")
            if not isinstance(usage, dict):
                continue
            seen = True
            total["input"] += int(usage.get("input") or 0)
            total["output"] += int(usage.get("output") or 0)
            total["cache_read"] += int(usage.get("cacheRead") or 0)
            total["cache_write"] += int(usage.get("cacheWrite") or 0)
            total["reasoning"] += int(usage.get("reasoning") or 0)
            total["cost_usd"] = round(total["cost_usd"] + float((usage.get("cost") or {}).get("total") or 0), 6)
            total["turns"] += 1
    return total if seen else None


def ledger(argv: list) -> int:
    """Print tokens and money per lane from the records, plus the total of the run.

    The lane's own `pi` bill used to live only in `~/.pi/agent/sessions`, so a run could not be
    totalled and a lane arm looked cheaper than it was. A record written before the runner kept the
    usage is billed from that session file instead, and marked with `~`.
    """
    parser = argparse.ArgumentParser(prog="pi-lane ledger")
    parser.add_argument("lanes", nargs="*")
    args = parser.parse_args(argv)
    wanted = set(args.lanes)
    rows = [r for r in lane_records() if not wanted or str(r.get("lane")) in wanted]
    if not rows:
        print("no lanes")
        return 0
    rows.sort(key=lambda r: r.get("started") or 0)
    print(f"{'lane':20s} {'state':8s} {'input':>9s} {'output':>8s} {'cache':>9s} {'usd':>9s} {'rev':>7s} {'min':>5s}  model")
    total = {"input": 0, "output": 0, "cache": 0, "usd": 0.0, "rev": 0.0}
    from_session = 0
    for record in rows:
        usage = record.get("usage") or {}
        mark = ""
        if not usage:
            usage = _usage_from_session(str(record.get("worktree") or "")) or {}
            mark = "~" if usage else ""
            from_session += 1 if mark else 0
        review_cost = float(((record.get("review") or {}).get("usage") or {}).get("cost_usd") or 0)
        started = record.get("started") or 0
        finished = record.get("finished") or 0
        minutes = int((finished - started) // 60) if finished and started else 0
        values = {
            "input": int(usage.get("input") or 0),
            "output": int(usage.get("output") or 0),
            "cache": int(usage.get("cache_read") or 0),
            "usd": float(usage.get("cost_usd") or 0),
            "rev": review_cost,
        }
        for key in total:
            total[key] += values[key]
        model = str(record.get("model") or "")
        print(f"{str(record.get('lane')):20s} {str(record.get('state')):8s} {values['input']:9d} "
              f"{values['output']:8d} {values['cache']:9d} {values['usd']:8.4f}{mark:1s} "
              f"{values['rev']:6.4f} {minutes:4d}  {model}")
    print(f"{'total':20s} {'':8s} {total['input']:9d} {total['output']:8d} {total['cache']:9d} "
          f"{total['usd']:8.4f} {total['rev']:6.4f}")
    if from_session:
        print("~ billed from the pi session file: the record was written before the runner kept usage")
    return 0


def main() -> int:
    if len(sys.argv) > 2 and sys.argv[1] == "wait" and "--all" in sys.argv[2:]:
        return wait_all(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "reap":
        return reap(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "resume":
        return resume_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "ledger":
        return ledger(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "dry-merge":
        return dry_merge(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "budget":
        return set_budget(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "review":
        return review_queue(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "digest":
        return digest_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "gate":
        return gate_lanes(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "wait":
        return wait_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "hand":
        return hand_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "answer":
        return answer_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "list":
        return list_lanes(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "close":
        return close_lanes(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "check":
        return check_lane(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "say":
        return say_in_thread(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "continue":
        return continue_lane(sys.argv[2:])

    parser = argparse.ArgumentParser(
        prog="pi-lane",
        epilog=(
            "verbs with the lane lifecycle: pi-lane wait <lane> [--timeout S] [--json] (block until it finishes or asks), "
            "pi-lane wait --all [lane …] (block on several at once, 3 if any asks), "
            "pi-lane gate <lane …> --cmd \"…\" (run the gates in the MERGED tree and record the check), "
            "pi-lane review (print the review shelf instead of injecting it), pi-lane digest <lane> (a compact record), "
            "pi-lane hand <lane> (file for review), "
            "pi-lane check <lane> (record that its work was read), "
            "pi-lane close <lane> [--no-merge] [--yes|--auto], "
            "pi-lane say <lane> \"text\", pi-lane answer <lane> \"value\", pi-lane list, "
            "pi-lane ledger [lane …] (tokens and money per lane), "
            "pi-lane dry-merge <lane …> (branches merged in memory, conflicts named), "
            "pi-lane reap (mark lanes whose runner is gone), pi-lane resume <lane> (continue one in "
            "its own session), "
            "pi-lane budget <lane> [--max-usd N] [--max-turns N] [--idle-timeout S]"
        ),
    )
    parser.add_argument("lane")
    parser.add_argument("task")
    parser.add_argument("--repo", default="", help="repository path; resolved from the registry when omitted")
    parser.add_argument("--project", default="", help="registered project name")
    parser.add_argument("--feature", "--group", dest="feature", default="", help="feature name inside the project")
    parser.add_argument("--provider", default=DEFAULT_PROVIDER)
    parser.add_argument("--model", default=DEFAULT_MODEL)
    parser.add_argument("--thinking", default=DEFAULT_THINKING)
    parser.add_argument("--question-timeout", type=int, default=1800)
    parser.add_argument("--max-usd", type=float, default=DEFAULT_MAX_USD,
                        help="stop the lane when its bill reaches this many dollars (0 = no cap)")
    parser.add_argument("--max-turns", type=int, default=DEFAULT_MAX_TURNS,
                        help="stop the lane after this many assistant messages in one run (0 = no cap)")
    parser.add_argument("--idle-timeout", type=int, default=DEFAULT_IDLE_TIMEOUT,
                        help="stop the lane after this many seconds without an event (0 = no cap)")
    parser.add_argument("--touch", action="append", default=[], metavar="GLOB",
                        help="a path or glob this lane owns; repeatable. Two lanes in flight with an "
                             "intersecting write-set are refused")
    parser.add_argument("--allow-overlap", action="store_true",
                        help="let this lane start although a lane in flight names the same file")
    parser.add_argument("--review-provider", default=DEFAULT_REVIEW_PROVIDER,
                        help="which provider the critic at `hand` uses (another vendor by default)")
    parser.add_argument("--review-model", default=DEFAULT_REVIEW_MODEL)
    parser.add_argument("--autonomy", choices=("auto", "ask"), default=DEFAULT_AUTONOMY,
                        help="auto: the lane answers its own dialogs; ask: a dialog parks it in waiting")
    args = parser.parse_args()

    if not LANE_RE.match(args.lane):
        fail(f"bad lane name: {args.lane}")

    # A brief is input tokens for this lane, every time. Show its size; a slice brief is under 2.5 KB.
    brief_bytes = len(args.task.encode("utf-8"))
    note = " — a slice brief is under 2500" if brief_bytes > 3000 else ""
    print(f"brief: {brief_bytes} bytes{note}", file=sys.stderr)

    project = args.project
    repo_path = args.repo
    if project:
        sys.path.insert(0, str(Path(__file__).resolve().parent))
        import pireg  # noqa: E402

        entry = pireg.project(pireg.load(), project)
        if entry is None:
            fail(f"unknown project: {project} — register it with pi-project add")
        repo_path = str(entry.get("repo") or "")
        if not repo_path:
            fail(f"project {project} has no repo path")
    if not repo_path:
        fail("pass --project or --repo")
    repo = os.path.realpath(repo_path)
    if not Path(repo, ".git").exists():
        fail(f"not a git repo: {repo}")
    project = project or Path(repo).name
    if not any(
        os.access(os.path.join(folder, "pi"), os.X_OK)
        for folder in os.environ.get("PATH", "").split(os.pathsep)
        if folder
    ):
        fail("pi not found")

    load_env_keys()

    lane = args.lane
    worktree = Path(repo) / ".worktrees" / lane
    branch = f"lane/{lane}"

    # Guards: one running lane per name in a repository, and a warning when the
    # same feature already has a lane in flight. No lock files: the record and
    # its pid are the truth.
    in_flight: list = []
    for record in lane_records():
        running = str(record.get("state")) == "running" and pid_alive(record.get("pid"))
        if not running:
            continue
        if record.get("lane") == lane and record.get("repo") == repo:
            fail(f"lane {lane} is already running in {repo}")
        if record.get("repo") == repo and args.feature and record.get("group") == args.feature.strip():
            in_flight.append(str(record.get("lane")))
    if in_flight:
        print(
            f"pi-lane: note — feature {args.feature} already has a lane in flight: {', '.join(in_flight)}",
            file=sys.stderr,
        )

    # Declared write-sets: worktrees stop write races, not semantic ones. Two lanes in flight that
    # name the same file merge into a conflict, or the second silently replaces the first's reasoning.
    my_touches = [path for path in (normalise_touch(item) for item in args.touch) if path]
    if my_touches:
        for record in lane_records():
            if record.get("repo") != repo or record.get("lane") == lane:
                continue
            if str(record.get("state")) not in ("running", "waiting"):
                continue
            theirs = [normalise_touch(item) for item in (record.get("touches") or [])]
            shared = touch_overlap(my_touches, theirs)
            if not shared:
                continue
            message = (f"write-set overlaps lane {record.get('lane')}: {', '.join(shared[:6])} — "
                       f"a slice that must touch a shared file starts after that lane merges")
            if args.allow_overlap:
                print(f"pi-lane: warning — {message}", file=sys.stderr)
            else:
                fail(message + " (override with --allow-overlap)")
    lane_dir = hermes_home() / "lanes" / lane
    lane_dir.mkdir(parents=True, exist_ok=True)
    events_path = lane_dir / "events.jsonl"
    stderr_path = lane_dir / "stderr.txt"
    question_path = lane_dir / "question.json"
    answer_path = lane_dir / "answer.json"
    for stale in (question_path, answer_path):
        if stale.exists():
            stale.unlink()
    events_path.write_text("", encoding="utf-8")

    if not worktree.is_dir():
        created = False
        for extra in (["-b", branch], []):
            done = subprocess.run(
                ["git", "-C", repo, "worktree", "add", "-q", str(worktree), *extra],
                capture_output=True, text=True, check=False,
            )
            if done.returncode == 0:
                created = True
                break
        if not created:
            fail(f"git worktree add failed for {worktree}")
    ensure_excludes(repo)

    record = {
        "lane": lane,
        "task": args.task,
        "project": project,
        "group": args.feature.strip(),
        "repo": repo,
        "worktree": str(worktree),
        "branch": branch,
        "base_sha": _git(repo, "rev-parse", _default_branch(repo))[1] or "",
        "session_id": f"{Path(repo).name}-{lane}",
        "provider": args.provider,
        "model": args.model,
        "thinking": args.thinking,
        "state": "running",
        "pid": os.getpid(),
        "started": int(time.time()),
        "exit": None,
        "touches": my_touches,
        "review_provider": args.review_provider,
        "review_model": args.review_model,
        "autonomy": args.autonomy,
        "budget": {
            "max_usd": args.max_usd,
            "max_turns": args.max_turns,
            "idle_timeout": args.idle_timeout,
        },
    }
    write_record(lane_dir, record)
    return run_session(lane_dir, record, lane, worktree, args.task, args.question_timeout)



if __name__ == "__main__":
    raise SystemExit(main())
